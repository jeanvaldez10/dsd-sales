<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
	<item android:state_pressed="true" >
		<shape>
			<solid
				android:color="@color/green_pressed_color" />
			<stroke
				android:width="1dp"
				android:color="@color/green_color" />
			<padding
				android:top="@dimen/dip_10"
				android:bottom="@dimen/dip_10"
				android:left="@dimen/dip_20"
				android:right="@dimen/dip_20" />
		</shape>
	</item>
	<item android:state_enabled="false" >
		<shape>
			<solid
				android:color="@color/green_disable_color" />
			<stroke
				android:width="1dp"
				android:color="@color/green_color" />
			<padding
				android:top="@dimen/dip_10"
				android:bottom="@dimen/dip_10"
				android:left="@dimen/dip_20"
				android:right="@dimen/dip_20" />
		</shape>
	</item>
	<item>
		<shape>
			<solid
				android:color="@color/green_color" />
			<stroke
				android:width="1dp"
				android:color="@color/green_color" />
			<padding
				android:top="@dimen/dip_10"
				android:bottom="@dimen/dip_10"
				android:left="@dimen/dip_20"
				android:right="@dimen/dip_20" />
		</shape>
	</item>
</selector>
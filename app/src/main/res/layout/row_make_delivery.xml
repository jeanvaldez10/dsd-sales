<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:paddingTop="@dimen/dip_2"
	android:paddingBottom="@dimen/dip_2"
	android:orientation="vertical"
	android:background="@drawable/table_normal"
	>
	<LinearLayout
		android:orientation="horizontal"
		android:layout_width="match_parent"
		android:layout_height="wrap_content">
		<TextView
			android:id="@+id/txtItemNo"
			android:layout_width="0dip"
			android:layout_weight="11"
			android:layout_height="wrap_content"
			android:text="123456789"
			style="@style/Font12NormalBlack"/>
		<TextView
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			style="@style/Font12NormalBlack"
			android:id="@+id/txtFreeItem"
			android:visibility="invisible"
			android:text="* "/>
		<TextView
			android:id="@+id/txtShortDesc"
			android:layout_width="0dip"
			android:layout_weight="18"
			android:layout_height="wrap_content"
			android:layout_marginLeft="@dimen/dip_2"
			android:text="Short Desc"
			style="@style/Font12NormalBlack"/>
		<TextView
			android:id="@+id/txtPickLocationCode"
			android:layout_width="0dip"
			android:layout_weight="3"
			android:layout_height="wrap_content"
			android:layout_marginLeft="@dimen/dip_2"
			android:text="XXX"
			style="@style/Font12NormalBlack"/>
		<TextView
			android:id="@+id/txtLoaded"
			android:layout_width="0dip"
			android:layout_weight="5"
			android:layout_height="wrap_content"
			android:layout_marginLeft="@dimen/dip_2"
			android:text="12345"
			android:gravity="right"
			style="@style/Font12NormalBlack"/>
	</LinearLayout>
	<LinearLayout
		android:visibility="gone"
		android:id="@+id/layoutDetailEntry"
		android:orientation="horizontal"
		android:layout_width="match_parent"
		android:layout_height="wrap_content">
		<View
			android:layout_width="0dip"
			android:layout_height="0dip"
			android:layout_weight="1">
		</View>
		<LinearLayout
			android:layout_weight="5"
			android:layout_width="0dip"
			android:orientation="horizontal"
			android:layout_height="wrap_content">
			<TextView
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				style="@style/Font12NormalBlack"
				android:id="@+id/txtAvailableTruck"
				/>
			<TextView
				android:gravity="right"
				android:layout_weight="1"
				android:layout_width="0dip"
				android:layout_height="wrap_content"
				style="@style/Font12NormalBlack"
				android:id="@+id/txtPrice"
				/>
		</LinearLayout>
	</LinearLayout>

</LinearLayout>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="fill_parent"
	android:layout_height="match_parent"
	android:layout_margin="@dimen/dip_20"
	android:padding="@dimen/dip_20"
	android:layout_gravity="center"
	android:background="@color/white_color"
	android:orientation="vertical">
	<LinearLayout
		android:orientation="vertical"
		android:layout_weight="1"
		android:layout_width="match_parent"
		android:layout_height="0dip">
		<TextView
			android:id="@+id/txtTitle"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_gravity="center_horizontal"
			android:text="DELIVERY INSTRUCTIONS"
			android:gravity="center_horizontal"
			style="@style/Font25BoldBlack" />
		<TextView
			android:id="@+id/txtDeliveryInstruction"
			android:layout_width="fill_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="@dimen/dip_15"
			android:text=""
			android:gravity="center_vertical"
			android:background="@drawable/table_normal"
			style="@style/Font15NormalBlack" />

		<LinearLayout
			android:orientation="vertical"
			android:layout_marginTop="@dimen/dip_15"
			android:id="@+id/layoutEditMessage"
			android:visibility="gone"
			android:layout_width="match_parent"
			android:layout_height="wrap_content">
			<EditText
				android:maxHeight="@dimen/dip_300"
				android:minHeight="@dimen/dip_250"
				android:maxLength="1000"
				android:gravity="top|left"
				style="@style/Font15NormalBlack"
				android:id="@+id/editDeliveryInstruction"
				android:layout_width="match_parent"
				android:layout_height="wrap_content">
			</EditText>
			<TextView
				android:id="@+id/txtCharacters"
				android:layout_width="fill_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="@dimen/dip_5"
				android:gravity="center_horizontal"
				android:text="10 Characters"
				style="@style/Font10NormalRed" />
		</LinearLayout>


		<RelativeLayout
			android:layout_marginTop="@dimen/dip_15"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_weight="1">

			<GridView
				android:layout_centerInParent="true"
				android:id="@+id/imgList"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_weight="1"
				android:numColumns="2">

			</GridView>
			<ProgressBar
				android:id="@+id/progress_bar"
				android:layout_centerInParent="true"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content">

			</ProgressBar>
		</RelativeLayout>
	</LinearLayout>



	<RelativeLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="@dimen/dip_20"
		android:orientation="horizontal">

		<Button
			android:id="@+id/btnUpdate"
			style="@style/Font20NormalWhite"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_alignParentLeft="true"
			android:background="@drawable/btn_orange_large"
			android:text="Update" />

		<dsd.dsdvansales.views.ClickEffectImageView
			android:layout_alignParentLeft="true"
			android:visibility="gone"
			android:id="@+id/btnNewPhoto"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:src="@drawable/icon_photo">

		</dsd.dsdvansales.views.ClickEffectImageView>

		<Button
			android:layout_alignParentRight="true"
			android:id="@+id/btnContinue"
			style="@style/Font20NormalWhite"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:background="@drawable/btn_orange_large"
			android:text="Continue" />
		<Button
			android:visibility="gone"
			android:layout_alignParentRight="true"
			android:id="@+id/btnSaveChanges"
			style="@style/Font20NormalWhite"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:background="@drawable/btn_orange_large"
			android:text="Continue" />
	</RelativeLayout>
</LinearLayout>
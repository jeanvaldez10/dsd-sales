<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical">
	<RelativeLayout
		android:background="@color/button_grey_color"
		android:layout_width="fill_parent"
		android:layout_height="wrap_content"
		android:padding="@dimen/dip_10"
		>
		<TextView
			android:layout_alignParentRight="true"
			android:id="@+id/txtTrip"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginLeft="@dimen/dip_10"
			android:text="Trip # 102040507"
			style="@style/Font15NormalWhite" />
	</RelativeLayout>
	<TextView
		android:id="@+id/lblTitle"
		android:layout_width="fill_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="@dimen/dip_10"
		android:gravity="center_horizontal"
		android:text="OFF LOAD INVENTORY"
		style="@style/Font25BoldGray" />
	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:orientation="vertical"
		android:padding="@dimen/dip_10">
		<ImageView
			android:layout_width="fill_parent"
			android:layout_height="@dimen/dip_1"
			android:background="@color/split_color" />
		<LinearLayout
			android:id="@+id/layoutButton"
			android:layout_width="fill_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="@dimen/dip_10">
			<TextView
				android:id="@+id/txtFresh"
				android:layout_width="0dip"
				android:layout_weight="1"
				android:layout_height="wrap_content"
				android:layout_marginRight="@dimen/dip_5"
				android:paddingTop="@dimen/dip_10"
				android:paddingBottom="@dimen/dip_10"
				android:text="Fresh"
				android:gravity="center"
				android:background="@color/vehicle_inventory_selected_color"
				style="@style/Font15NormalWhite" />
			<TextView
				android:id="@+id/txtReturns"
				android:layout_width="0dip"
				android:layout_weight="1"
				android:layout_height="wrap_content"
				android:layout_marginLeft="@dimen/dip_5"
				android:layout_marginRight="@dimen/dip_5"
				android:paddingTop="@dimen/dip_10"
				android:paddingBottom="@dimen/dip_10"
				android:text="Returns"
				android:gravity="center"
				android:background="@color/vehicle_inventory_normal_color"
				style="@style/Font15NormalWhite" />
			<TextView
				android:id="@+id/txtSpoils"
				android:layout_width="0dip"
				android:layout_weight="1"
				android:layout_height="wrap_content"
				android:layout_marginLeft="@dimen/dip_5"
				android:layout_marginRight="@dimen/dip_5"
				android:paddingTop="@dimen/dip_10"
				android:paddingBottom="@dimen/dip_10"
				android:text="Spoils"
				android:gravity="center"
				android:background="@color/vehicle_inventory_normal_color"
				style="@style/Font15NormalWhite" />
			<TextView
				android:id="@+id/txtContainers"
				android:layout_width="0dip"
				android:layout_weight="1"
				android:layout_height="wrap_content"
				android:layout_marginLeft="@dimen/dip_5"
				android:paddingTop="@dimen/dip_10"
				android:paddingBottom="@dimen/dip_10"
				android:text="Containers"
				android:gravity="center"
				android:background="@color/vehicle_inventory_normal_color"
				style="@style/Font15NormalWhite" />
		</LinearLayout>
		<LinearLayout
			android:layout_width="fill_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="@dimen/dip_10"
			android:layout_marginBottom="@dimen/dip_10"
			>
			<EditText
				android:id="@+id/editItemNo"
				android:layout_width="0dip"
				android:layout_weight="3"
				android:layout_height="wrap_content"
				android:inputType="textEmailAddress"
				android:imeOptions="actionNext"
				style="@style/Font15NormalBlack" />
			<TextView
				android:id="@+id/txtQty"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginLeft="@dimen/dip_10"
				android:text="Qty"
				style="@style/Font15NormalBlack" />
			<EditText
				android:id="@+id/editCase"
				android:layout_width="0dip"
				android:layout_weight="1.4"
				android:layout_height="wrap_content"
				android:layout_marginLeft="@dimen/dip_5"
				android:singleLine="true"
				android:inputType="number"
				android:imeOptions="actionNext"
				android:maxLength="3"
				style="@style/Font15NormalBlack" />
			<TextView
				android:id="@+id/txtCaseSplit"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginLeft="@dimen/dip_10"
				android:text="/"
				style="@style/Font15NormalBlack" />
			<EditText
				android:id="@+id/editQty"
				android:layout_width="0dip"
				android:layout_weight="1.4"
				android:layout_height="wrap_content"
				android:layout_marginLeft="@dimen/dip_5"
				android:singleLine="true"
				android:inputType="number"
				android:imeOptions="actionDone"
				android:maxLength="8"
				style="@style/Font15NormalBlack" />
		</LinearLayout>
		<LinearLayout
			android:layout_width="fill_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="@dimen/dip_5"
			android:orientation="vertical">
			<TextView
				android:id="@+id/txtDescription"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:text="Invalid Product"
				style="@style/Font15NormalBlack" />
			<LinearLayout
				android:orientation="horizontal"
				android:layout_width="match_parent"
				android:layout_height="wrap_content">
				<dsd.dsdvansales.views.ClickEffectImageView
					android:id="@+id/btnSort"
					android:layout_gravity="center"
					android:layout_width="@dimen/dip_30"
					android:layout_height="@dimen/dip_30"
					android:src="@drawable/icon_sort"/>
				<View
					android:layout_width="0dip"
					android:layout_height="0dip"
					android:layout_weight="1"></View>
				<Button
					android:id="@+id/btnAdd"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginLeft="@dimen/dip_10"
					android:padding="@dimen/dip_10"
					android:background="@drawable/btn_orange_large"
					android:text="Off Load"
					style="@style/Font15NormalWhite" />
			</LinearLayout>

		</LinearLayout>
		<ImageView
			android:layout_width="fill_parent"
			android:layout_height="@dimen/dip_1"
			android:layout_marginTop="@dimen/dip_5"
			android:background="@color/split_color" />
		<LinearLayout
			android:layout_width="fill_parent"
			android:layout_height="0dip"
			android:layout_weight="1"
			android:layout_marginTop="@dimen/dip_5"
			android:orientation="vertical">
			<ListView
				android:id="@+id/listView"
				android:layout_width="fill_parent"
				android:layout_height="0dip"
				android:layout_weight="1"
				android:dividerHeight="0dp"
				android:divider="@color/transparent_color" />
			<TextView
				android:id="@+id/txtNoData"
				android:layout_width="fill_parent"
				android:layout_height="fill_parent"
				android:text="@string/msg_no_data"
				android:gravity="center"
				android:visibility="gone"
				style="@style/Font20NormalGray" />
		</LinearLayout>
		<ImageView
			android:layout_width="fill_parent"
			android:layout_height="@dimen/dip_1"
			android:layout_marginTop="@dimen/dip_5"
			android:background="@color/split_color" />
		<LinearLayout
			android:layout_width="fill_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="@dimen/dip_10"
			android:orientation="horizontal">
			<Button
				android:id="@+id/btnBack"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:padding="@dimen/dip_10"
				android:layout_gravity="center_vertical"
				android:drawableLeft="@drawable/icon_left_arrow"
				android:background="@drawable/btn_button_grey_large" />
			<ImageView
				android:layout_width="0dip"
				android:layout_weight="1"
				android:layout_height="wrap_content" />

			<Button
				android:id="@+id/btnProductTreeList"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:padding="@dimen/dip_5"
				android:drawableLeft="@drawable/icon_tree"
				android:background="@drawable/btn_white_medium" />
			<ImageView
				android:layout_width="0dip"
				android:layout_weight="1"
				android:layout_height="fill_parent" />
			<Button
				android:id="@+id/btnBarcodeScanner"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:padding="@dimen/dip_5"
				android:drawableLeft="@drawable/icon_barcode"
				android:background="@drawable/btn_white_medium" />
			<ImageView
				android:layout_width="0dip"
				android:layout_weight="1"
				android:layout_height="fill_parent" />
			<Button
				android:id="@+id/btnProductSearch"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:padding="@dimen/dip_5"
				android:drawableLeft="@drawable/icon_search2"
				android:background="@drawable/btn_white_medium" />
			<ImageView
				android:layout_width="0dip"
				android:layout_weight="1"
				android:layout_height="fill_parent" />

			<Button
				android:id="@+id/btnDone"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_gravity="center_vertical"
				android:background="@drawable/btn_orange_large"
				android:text="Done"
				style="@style/Font20NormalWhite" />
		</LinearLayout>
	</LinearLayout>

</LinearLayout>
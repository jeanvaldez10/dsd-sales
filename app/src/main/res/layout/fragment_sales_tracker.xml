<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical">

	<LinearLayout
		android:background="@color/button_grey_color"
		android:layout_width="fill_parent"
		android:layout_height="wrap_content"
		android:padding="@dimen/dip_10"
		>
		<TextView
			android:id="@+id/txtDriverName"
			android:layout_width="0dip"
			android:layout_weight="1"
			android:layout_height="wrap_content"
			android:text="Driver Name"
			style="@style/Font15NormalWhite" />
		<TextView
			android:gravity="right"
			android:id="@+id/txtDeliveryDate"
			android:layout_width="0dip"
			android:layout_weight="1"
			android:layout_height="wrap_content"
			android:text="August 28, 2020"
			style="@style/Font15NormalWhite" />
	</LinearLayout>
<RelativeLayout
		android:layout_width="fill_parent"
		android:layout_height="0dip"
		android:layout_weight="1">
	<LinearLayout
		android:id="@+id/layoutMain"
		android:layout_width="fill_parent"
		android:layout_height="fill_parent"
		android:orientation="vertical">

	<TextView
		android:id="@+id/lblSalesTracker"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_margin="@dimen/dip_10"
		android:layout_gravity="center_horizontal"
		android:text="SALES TRACKER"
		style="@style/Font25BoldGray" />

	<ScrollView
		android:layout_width="fill_parent"
		android:layout_height="0dip"
		android:layout_weight="1">
		<LinearLayout
			android:layout_marginLeft="@dimen/dip_10"
			android:layout_marginRight="@dimen/dip_10"
			android:layout_width="fill_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical">
			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="vertical"
				android:layout_marginTop="@dimen/dip_10"
				android:background="@color/focus_orange_color">
				<TextView

					android:padding="@dimen/dip_10"
					android:textAllCaps="true"
					android:id="@+id/lblMonthPerformance"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					style="@style/Font15NormalWhite"
					android:text="Month Performance"
					/>
				<LinearLayout
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:orientation="horizontal">
					<TextView
						android:paddingBottom="@dimen/dip_10"
						android:paddingLeft="@dimen/dip_5"
						android:paddingRight="@dimen/dip_5"
						android:gravity="center"
						android:id="@+id/lblSalesMTD"
						android:layout_width="0dip"
						android:layout_weight="1"
						android:layout_height="wrap_content"
						style="@style/Font12NormalWhite"
						android:text="Sales MTD" />
					<View
						android:layout_width="@dimen/dip_2"
						android:layout_height="match_parent"/>
					<TextView
						android:paddingBottom="@dimen/dip_10"
						android:paddingLeft="@dimen/dip_5"
						android:paddingRight="@dimen/dip_5"
						android:gravity="center"
						android:id="@+id/lblMonthTarget"
						android:layout_width="0dip"
						android:layout_weight="1"
						android:layout_height="wrap_content"
						style="@style/Font12NormalWhite"
						android:text="Month Target"/>
					<View
						android:layout_width="@dimen/dip_2"
						android:layout_height="match_parent"/>
					<TextView
						android:paddingBottom="@dimen/dip_10"
						android:paddingLeft="@dimen/dip_5"
						android:paddingRight="@dimen/dip_5"
						android:gravity="center"
						android:id="@+id/lblRemaining"
						android:layout_width="0dip"
						android:layout_weight="1"
						android:layout_height="wrap_content"
						style="@style/Font12NormalWhite"
						android:text="Remaining"/>
					<View
						android:layout_width="@dimen/dip_2"
						android:layout_height="match_parent"/>
					<TextView
						android:paddingBottom="@dimen/dip_10"
						android:paddingLeft="@dimen/dip_5"
						android:paddingRight="@dimen/dip_5"
						android:gravity="center"
						android:id="@+id/lblPercentage"
						android:layout_width="0dip"
						android:layout_weight="1"
						android:layout_height="wrap_content"
						style="@style/Font12NormalWhite"
						android:text="Percentage"/>
				</LinearLayout>
				<LinearLayout
					android:background="@color/focus_orange_back_color"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:orientation="horizontal">
					<TextView
						android:paddingTop="@dimen/dip_10"
						android:paddingBottom="@dimen/dip_10"
						android:paddingLeft="@dimen/dip_5"
						android:paddingRight="@dimen/dip_5"
						android:gravity="center"
						android:id="@+id/txtSalesMTD"
						android:layout_width="0dip"
						android:layout_weight="1"
						android:layout_height="wrap_content"
						style="@style/Font12NormalBlack"
						android:text="10,166.44" />
					<View
						android:background="@color/white_color"
						android:layout_width="@dimen/dip_2"
						android:layout_height="match_parent"/>
					<TextView
						android:paddingTop="@dimen/dip_10"
						android:paddingBottom="@dimen/dip_10"
						android:paddingLeft="@dimen/dip_5"
						android:paddingRight="@dimen/dip_5"
						android:gravity="center"
						android:id="@+id/txtMonthTarget"
						android:layout_width="0dip"
						android:layout_weight="1"
						android:layout_height="wrap_content"
						style="@style/Font12NormalBlack"
						android:text="30,000.00"/>
					<View
						android:background="@color/white_color"
						android:layout_width="@dimen/dip_2"
						android:layout_height="match_parent"/>
					<TextView
						android:paddingTop="@dimen/dip_10"
						android:paddingBottom="@dimen/dip_10"
						android:paddingLeft="@dimen/dip_5"
						android:paddingRight="@dimen/dip_5"
						android:gravity="center"
						android:id="@+id/txtRemaining"
						android:layout_width="0dip"
						android:layout_weight="1"
						android:layout_height="wrap_content"
						style="@style/Font12NormalBlack"
						android:text="19,833.56"/>
					<View
						android:background="@color/white_color"
						android:layout_width="@dimen/dip_2"
						android:layout_height="match_parent"/>
					<TextView
						android:paddingTop="@dimen/dip_10"
						android:paddingBottom="@dimen/dip_10"
						android:paddingLeft="@dimen/dip_5"
						android:paddingRight="@dimen/dip_5"
						android:gravity="center"
						android:id="@+id/txtPercentage"
						android:layout_width="0dip"
						android:layout_weight="1"
						android:layout_height="wrap_content"
						style="@style/Font12NormalRed"
						android:text="34%"/>
				</LinearLayout>
			</LinearLayout>
			<LinearLayout
				android:layout_marginTop="@dimen/dip_20"
				android:layout_marginBottom="@dimen/dip_20"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="vertical"

				android:background="@color/focus_orange_color">
				<TextView
					android:padding="@dimen/dip_10"
					android:textAllCaps="true"
					android:id="@+id/lblWeekPerformance"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					style="@style/Font15NormalWhite"
					android:text="Week Performance"
					/>
				<LinearLayout
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:orientation="horizontal">
					<TextView
						android:paddingBottom="@dimen/dip_10"
						android:gravity="center"
						android:id="@+id/lblSalesToday"
						android:layout_width="0dip"
						android:layout_weight="1"
						android:layout_height="match_parent"
						style="@style/Font12NormalWhite"
						android:text="Sales Today" />
					<View
						android:layout_width="@dimen/dip_2"
						android:layout_height="match_parent"/>
					<TextView
						android:paddingBottom="@dimen/dip_10"
						android:gravity="center"
						android:id="@+id/lblSalesThisWeek"
						android:layout_width="0dip"
						android:layout_weight="1"
						android:layout_height="match_parent"
						style="@style/Font12NormalWhite"
						android:text="This week"/>
					<View
						android:layout_width="@dimen/dip_2"
						android:layout_height="match_parent"/>
					<TextView
						android:paddingBottom="@dimen/dip_10"
						android:gravity="center"
						android:id="@+id/lblSalesLastWeek"
						android:layout_width="0dip"
						android:layout_weight="1"
						android:layout_height="match_parent"
						style="@style/Font12NormalWhite"
						android:text="Last week"/>
					<View
						android:layout_width="@dimen/dip_2"
						android:layout_height="match_parent"/>
					<TextView
						android:paddingBottom="@dimen/dip_10"
						android:gravity="center"
						android:id="@+id/lblThisweekvslastweek"
						android:layout_width="0dip"
						android:layout_weight="1"
						android:layout_height="match_parent"
						style="@style/Font12NormalWhite"
						android:text="Comparison"/>
				</LinearLayout>
				<LinearLayout
					android:background="@color/focus_orange_back_color"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:orientation="horizontal">
					<TextView
						android:paddingTop="@dimen/dip_10"
						android:paddingBottom="@dimen/dip_10"
						android:paddingLeft="@dimen/dip_5"
						android:paddingRight="@dimen/dip_5"
						android:gravity="center"
						android:id="@+id/txtSalesToday"
						android:layout_width="0dip"
						android:layout_weight="1"
						android:layout_height="wrap_content"
						style="@style/Font12NormalBlack"
						android:text="0.00" />
					<View
						android:background="@color/white_color"
						android:layout_width="@dimen/dip_2"
						android:layout_height="match_parent"/>
					<TextView
						android:paddingTop="@dimen/dip_10"
						android:paddingBottom="@dimen/dip_10"
						android:paddingLeft="@dimen/dip_5"
						android:paddingRight="@dimen/dip_5"
						android:gravity="center"
						android:id="@+id/txtSalesThisWeek"
						android:layout_width="0dip"
						android:layout_weight="1"
						android:layout_height="wrap_content"
						style="@style/Font12NormalBlack"
						android:text="7,417.13"/>
					<View
						android:background="@color/white_color"
						android:layout_width="@dimen/dip_2"
						android:layout_height="match_parent"/>
					<TextView
						android:paddingTop="@dimen/dip_10"
						android:paddingBottom="@dimen/dip_10"
						android:paddingLeft="@dimen/dip_5"
						android:paddingRight="@dimen/dip_5"
						android:gravity="center"
						android:id="@+id/txtSalesLastWeek"
						android:layout_width="0dip"
						android:layout_weight="1"
						android:layout_height="wrap_content"
						style="@style/Font12NormalBlack"
						android:text="6,755.12"/>
					<View
						android:background="@color/white_color"
						android:layout_width="@dimen/dip_2"
						android:layout_height="match_parent"/>
					<TextView
						android:paddingTop="@dimen/dip_10"
						android:paddingBottom="@dimen/dip_10"
						android:paddingLeft="@dimen/dip_5"
						android:paddingRight="@dimen/dip_5"
						android:gravity="center"
						android:id="@+id/txtThisweekvsLastweek"
						android:layout_width="0dip"
						android:layout_weight="1"
						android:layout_height="wrap_content"
						style="@style/Font12NormalGreen"
						android:text="110%"/>
				</LinearLayout>
			</LinearLayout>
			<LinearLayout
				android:layout_width="fill_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="@dimen/dip_10"
				android:layout_marginLeft="@dimen/dip_10"
				android:layout_marginRight="@dimen/dip_10">
				<TextView
					android:id="@+id/lblSalesQuantityToday"
					android:layout_width="0dip"
					android:layout_weight="3"
					android:layout_height="wrap_content"
					android:text="Total Sales quantity today"
					style="@style/Font15NormalBlack" />
				<TextView
					android:id="@+id/txtSalesQuantityToday"
					android:layout_width="0dip"
					android:layout_weight="2"
					android:layout_height="wrap_content"
					android:text="0"
					android:gravity="right"
					style="@style/Font15NormalBlack" />
			</LinearLayout>
			<LinearLayout
				android:layout_width="fill_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="@dimen/dip_10"
				android:layout_marginLeft="@dimen/dip_10"
				android:layout_marginRight="@dimen/dip_10">
				<TextView
					android:id="@+id/lblTotalPaymentsToday"
					android:layout_width="0dip"
					android:layout_weight="3"
					android:layout_height="wrap_content"
					android:text="Total payments today"
					style="@style/Font15NormalBlack" />
				<TextView
					android:id="@+id/txtCollectionsToday"
					android:layout_width="0dip"
					android:layout_weight="2"
					android:layout_height="wrap_content"
					android:text="$0.00"
					android:gravity="right"
					style="@style/Font15NormalBlack" />
			</LinearLayout>
			<LinearLayout
				android:layout_width="fill_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="@dimen/dip_10"
				android:layout_marginLeft="@dimen/dip_10"
				android:layout_marginRight="@dimen/dip_10">
				<TextView
					android:id="@+id/lblReturnsToday"
					android:layout_width="0dip"
					android:layout_weight="3"
					android:layout_height="wrap_content"
					android:text="Returns today"
					style="@style/Font15NormalBlack" />
				<TextView
					android:id="@+id/txtReturnsToday"
					android:layout_width="0dip"
					android:layout_weight="2"
					android:layout_height="wrap_content"
					android:text="$0.00"
					android:gravity="right"
					style="@style/Font15NormalBlack" />
			</LinearLayout>
			<LinearLayout
				android:layout_width="fill_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="@dimen/dip_10"
				android:layout_marginLeft="@dimen/dip_10"
				android:layout_marginRight="@dimen/dip_10">
				<TextView
					android:id="@+id/lblReturnQuantityToday"
					android:layout_width="0dip"
					android:layout_weight="3"
					android:layout_height="wrap_content"
					android:text="Total Returns quantity today"
					style="@style/Font15NormalBlack" />
				<TextView
					android:id="@+id/txtReturnsQuantityToday"
					android:layout_width="0dip"
					android:layout_weight="2"
					android:layout_height="wrap_content"
					android:text="0"
					android:gravity="right"
					style="@style/Font15NormalBlack" />
			</LinearLayout>
		</LinearLayout>
	</ScrollView>

	<RelativeLayout
		android:layout_width="fill_parent"
		android:layout_height="wrap_content"
		android:layout_margin="@dimen/dip_10"
		android:orientation="horizontal">
		<Button
			android:id="@+id/btnBack"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:padding="@dimen/dip_10"
			android:layout_alignParentRight="true"
			android:layout_centerVertical="true"
			android:text="Return"
			style="@style/Font20NormalWhite"
			android:background="@drawable/btn_orange_large" />
	
	</RelativeLayout>

	</LinearLayout>

	</RelativeLayout>
</LinearLayout>
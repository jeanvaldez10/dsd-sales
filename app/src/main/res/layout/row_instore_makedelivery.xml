
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="wrap_content"
	android:layout_height="wrap_content"
	android:orientation="vertical"
	>
	<Button
		android:id="@+id/btnPresold"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_marginLeft="@dimen/dip_10"
		android:padding="@dimen/dip_5"
		android:layout_gravity="center_vertical"
		android:drawableLeft="@drawable/icon_has_presold"
		android:background="@drawable/btn_white_small"
		/>
	<TextView
		android:layout_marginLeft="@dimen/dip_5"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:id="@+id/txtPresold"
		style="@style/Font12NormalBlack"
		android:layout_gravity="center_horizontal"/>
</LinearLayout>

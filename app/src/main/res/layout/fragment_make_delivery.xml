<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="match_parent">
	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:orientation="vertical">
		<RelativeLayout
			android:background="@color/button_grey_color"
			android:padding="@dimen/dip_10"
			android:layout_width="match_parent"
			android:layout_height="wrap_content">
			<TextView
				android:id="@+id/txtCustomerName"
				android:layout_width="fill_parent"
				android:layout_height="wrap_content"
				android:text="Customer Name"
				style="@style/Font15NormalWhite" />
		</RelativeLayout>
		<TextView
			android:id="@+id/lblTitle"
			android:layout_width="fill_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="@dimen/dip_10"
			android:gravity="center_horizontal"
			android:text="DELIVERY"
			style="@style/Font25BoldGray" />
		<ImageView
			android:layout_width="fill_parent"
			android:layout_height="@dimen/dip_1"
			android:layout_marginTop="@dimen/dip_10"
			android:layout_marginLeft="@dimen/dip_10"
			android:layout_marginRight="@dimen/dip_10"
			android:background="@color/split_color" />
		<LinearLayout
			android:layout_width="fill_parent"
			android:layout_height="wrap_content"
			android:layout_margin="@dimen/dip_10">
			<EditText
				android:id="@+id/editItemNo"
				android:layout_width="0dip"
				android:layout_weight="3"
				android:layout_height="wrap_content"
				android:inputType="textEmailAddress"
				android:imeOptions="actionNext"
				style="@style/Font15NormalBlack" />
			<TextView
				android:id="@+id/txtQty"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginLeft="@dimen/dip_10"
				android:text="  Qty"
				style="@style/Font15NormalBlack" />
			<EditText
				android:id="@+id/editCase"
				android:layout_width="0dip"
				android:layout_weight="1.5"
				android:layout_height="wrap_content"
				android:layout_marginLeft="@dimen/dip_5"
				android:singleLine="true"
				android:inputType="number"
				android:imeOptions="actionNext"
				android:maxLength="3"
				style="@style/Font15NormalBlack" />
			<TextView
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginLeft="@dimen/dip_10"
				android:id="@+id/lblSep"
				android:text="/"
				style="@style/Font15NormalBlack" />
			<EditText
				android:id="@+id/editQty"
				android:layout_width="0dip"
				android:layout_weight="1.5"
				android:layout_height="wrap_content"
				android:layout_marginLeft="@dimen/dip_5"
				android:singleLine="true"
				android:inputType="number"
				android:imeOptions="actionDone"
				android:maxLength="8"
				style="@style/Font15NormalBlack" />
		</LinearLayout>
		<LinearLayout
			android:layout_width="fill_parent"
			android:layout_height="wrap_content"
			android:layout_marginLeft="@dimen/dip_10"
			android:layout_marginRight="@dimen/dip_10"
			android:orientation="vertical">
			<TextView
				android:id="@+id/txtDescription"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:text="Invalid Product"
				style="@style/Font15NormalBlack" />
			<LinearLayout
				android:layout_width="match_parent"
				android:orientation="horizontal"
				android:layout_height="wrap_content">
				<!--			<Button-->
				<!--				android:layout_gravity="bottom"-->
				<!--				android:visibility="visible"-->
				<!--				android:id="@+id/btnOrderHistory"-->
				<!--				android:layout_width="wrap_content"-->
				<!--				android:layout_height="wrap_content"-->
				<!--				android:padding="0dip"-->
				<!--				android:layout_centerVertical="true"-->
				<!--				android:drawableLeft="@drawable/icon_history"-->
				<!--				android:background="@drawable/btn_white_small"-->
				<!--				android:layout_marginRight="@dimen/dip_10"/>-->
				<dsd.dsdvansales.views.ClickEffectImageView
					android:id="@+id/btnOrderHistory"
					android:layout_gravity="center"
					android:layout_width="@dimen/dip_30"
					android:layout_height="@dimen/dip_30"
					android:src="@drawable/icon_history"/>
				<dsd.dsdvansales.views.ClickEffectImageView
					android:id="@+id/btnFilter"
					android:layout_gravity="center"
					android:layout_width="@dimen/dip_30"
					android:layout_height="@dimen/dip_30"
					android:src="@drawable/icon_filter"/>
				<dsd.dsdvansales.views.ClickEffectImageView
					android:id="@+id/btnSort"
					android:layout_gravity="center"
					android:layout_width="@dimen/dip_30"
					android:layout_height="@dimen/dip_30"
					android:layout_marginLeft="@dimen/dip_5"
					android:src="@drawable/icon_sort"/>
				<LinearLayout
					android:layout_gravity="bottom"
					android:layout_width="0dip"
					android:layout_height="wrap_content"
					android:orientation="vertical"
					android:layout_weight="1">
					<TextView
						android:padding="@dimen/dip_5"
						android:visibility="gone"
						android:id="@+id/txtReason"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:drawableRight="@drawable/icon_drop_down"
						android:layout_gravity="center"
						android:text="Wrong City"
						android:background="@drawable/btn_grey_large"
						style="@style/Font15NormalBlack" />
					<LinearLayout
						android:layout_marginTop="@dimen/dip_5"
						android:layout_width="wrap_content"
						android:layout_gravity="center|bottom"
						android:layout_height="wrap_content"
						android:orientation="horizontal">
						<TextView
							android:gravity="right"
							android:layout_weight="1"
							android:layout_width="0dip"
							android:layout_height="wrap_content"
							android:layout_gravity="bottom"
							android:id="@+id/lblCartons"
							android:text="Count"
							style="@style/Font15NormalBlack"/>
						<TextView
							android:text="0"
							android:layout_marginLeft="@dimen/dip_5"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:layout_gravity="bottom"
							android:id="@+id/txtCartons"
							style="@style/Font15BoldBlack"/>
					</LinearLayout>
				</LinearLayout>
				<TextView
					android:id="@+id/txtPriceInv"
					style="@style/Font12NormalBlack"
					android:gravity="right"
					android:layout_gravity="bottom"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:orientation="vertical"
					>

				</TextView>
				<Button
					android:minWidth="@dimen/dip_80"
					android:id="@+id/btnAdd"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginLeft="@dimen/dip_5"
					android:padding="@dimen/dip_10"
					android:background="@drawable/btn_orange_large"
					android:text="Delivery"
					android:layout_gravity="right|bottom"
					style="@style/Font15NormalWhite" />
			</LinearLayout>


		</LinearLayout>
		<ImageView
			android:layout_width="fill_parent"
			android:layout_height="@dimen/dip_1"
			android:layout_marginTop="@dimen/dip_5"
			android:layout_marginLeft="@dimen/dip_10"
			android:layout_marginRight="@dimen/dip_10"
			android:background="@color/split_color" />
		<dsd.dsdvansales.views.FullDrawerLayout
			android:layout_width="match_parent"
			android:layout_height="0dip"
			android:layout_marginLeft="@dimen/dip_10"
			android:layout_weight="1">
			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				android:layout_marginTop="@dimen/dip_5"
				android:layout_marginRight="@dimen/dip_10"
				android:orientation="vertical">
				<ListView
					android:id="@+id/listView"
					android:layout_width="fill_parent"
					android:layout_height="0dip"
					android:layout_weight="1"
					android:dividerHeight="0dp"
					android:divider="@color/transparent_color" />
				<TextView
					android:id="@+id/txtMore"
					android:layout_width="fill_parent"
					android:layout_height="wrap_content"
					android:text="....."
					android:gravity="center"
					android:visibility="gone"
					style="@style/Font20BoldBlue" />
				<TextView
					android:id="@+id/txtNoData"
					android:layout_width="fill_parent"
					android:layout_height="fill_parent"
					android:text="@string/msg_no_data"
					android:gravity="center"
					android:visibility="gone"
					style="@style/Font20NormalGray" />
			</LinearLayout>
			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				android:orientation="vertical"
				android:background="@color/white_color"
				android:layout_gravity="right">

				<ListView
					android:id="@+id/slidelistView"
					android:layout_width="fill_parent"
					android:layout_height="0dip"
					android:layout_weight="1"
					android:dividerHeight="0dp"
					android:divider="@color/transparent_color"
					android:layout_marginLeft="@dimen/dip_10"
					android:layout_marginRight="@dimen/dip_10"/>
				<TextView
					android:id="@+id/txtSlideMore"
					android:layout_width="fill_parent"
					android:layout_height="wrap_content"
					android:text="....."
					android:gravity="center"
					android:visibility="gone"
					style="@style/Font20BoldBlue" />
				<TextView
					android:id="@+id/txtSlideNoData"
					android:layout_width="fill_parent"
					android:layout_height="fill_parent"
					android:text="@string/msg_no_data"
					android:gravity="center"
					android:visibility="gone"
					style="@style/Font20NormalGray" />
			</LinearLayout>

		</dsd.dsdvansales.views.FullDrawerLayout>
		<LinearLayout
			android:id="@+id/layoutTotal"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical">
			<ImageView
				android:layout_width="fill_parent"
				android:layout_height="@dimen/dip_1"
				android:layout_marginTop="@dimen/dip_5"
				android:layout_marginLeft="@dimen/dip_10"
				android:layout_marginRight="@dimen/dip_10"
				android:id="@+id/splitTotalOrder"
				android:background="@color/split_color" />
			<LinearLayout
				android:layout_width="fill_parent"
				android:layout_height="wrap_content"
				android:layout_marginLeft="@dimen/dip_10"
				android:layout_marginTop="@dimen/dip_10"
				android:layout_marginBottom="@dimen/dip_5"
				android:layout_marginRight="@dimen/dip_10"
				android:orientation="horizontal"
				android:id="@+id/layoutTotalOrder"
				>
				<TextView
					android:layout_width="0dip"
					android:layout_weight="1"
					android:layout_height="wrap_content"
					android:text="Order Total inc GST"
					android:id="@+id/txtOrderTotal"
					android:textStyle="bold"
					android:gravity="center"
					style="@style/Font15BoldBlack"
					android:layout_gravity="center"
					/>

				<TextView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="$0.00"
					android:id="@+id/txtOrderTotalValue"
					android:layout_marginLeft="@dimen/dip_10"
					android:layout_marginRight="@dimen/dip_10"
					android:textStyle="bold"
					style="@style/Font15BoldBlack"
					/>


			</LinearLayout>
		</LinearLayout>

		<ImageView
			android:layout_width="fill_parent"
			android:layout_height="@dimen/dip_1"
			android:layout_marginTop="@dimen/dip_5"
			android:layout_marginLeft="@dimen/dip_10"
			android:layout_marginRight="@dimen/dip_10"
			android:background="@color/split_color" />
		<RelativeLayout
			android:layout_width="fill_parent"
			android:layout_height="wrap_content"
			android:layout_marginLeft="@dimen/dip_10"
			android:layout_marginRight="@dimen/dip_10"
			android:layout_marginTop="@dimen/dip_1"
			android:layout_marginBottom="@dimen/dip_10"
			android:orientation="horizontal">
			<Button
				android:id="@+id/btnBack"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:padding="@dimen/dip_10"
				android:layout_gravity="center_vertical"
				android:drawableLeft="@drawable/icon_left_arrow"
				android:background="@drawable/btn_button_grey_large"
				android:layout_alignParentLeft="true"
				android:layout_centerVertical="true"/>
			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_centerVertical="true"
				android:layout_toRightOf="@+id/btnBack"
				android:layout_toLeftOf="@+id/btnCompleted">
				<ImageView
					android:layout_width="0dip"
					android:layout_weight="1"
					android:layout_height="fill_parent" />
				<Button
					android:id="@+id/btnProductTreeList"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:padding="@dimen/dip_5"
					android:drawableLeft="@drawable/icon_tree"
					android:background="@drawable/btn_white_medium" />
				<ImageView
					android:layout_width="0dip"
					android:layout_weight="1"
					android:layout_height="fill_parent" />
				<Button
					android:id="@+id/btnBarcodeScanner"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:padding="@dimen/dip_5"
					android:drawableLeft="@drawable/icon_barcode"
					android:background="@drawable/btn_white_medium" />
				<ImageView
					android:layout_width="0dip"
					android:layout_weight="1"
					android:layout_height="fill_parent" />
				<Button
					android:id="@+id/btnProductSearch"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:padding="@dimen/dip_5"
					android:drawableLeft="@drawable/icon_search2"
					android:background="@drawable/btn_white_medium" />
				<ImageView
					android:layout_width="0dip"
					android:layout_weight="1"
					android:layout_height="fill_parent" />

			</LinearLayout>

			<Button
				android:id="@+id/btnPhoto"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:padding="@dimen/dip_5"
				android:layout_centerVertical="true"
				android:drawableLeft="@drawable/icon_photo"
				android:background="@drawable/btn_white_small"
				android:visibility="gone"/>

			<Button
				android:id="@+id/btnCompleted"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:background="@drawable/btn_orange_large"
				android:text="Completed"
				android:padding="@dimen/dip_10"
				android:layout_gravity="center_vertical"
				style="@style/Font20NormalWhite"
				android:layout_alignParentRight="true"
				android:layout_centerVertical="true"/>
		</RelativeLayout>
	</LinearLayout>

	<dsd.dsdvansales.views.ClickEffectImageView
		android:id="@+id/btnSoma"
		android:adjustViewBounds="true"
		android:src="@drawable/soma_"
		android:layout_width="@dimen/dip_75"
		android:layout_height="@dimen/dip_75">

	</dsd.dsdvansales.views.ClickEffectImageView>

</RelativeLayout>
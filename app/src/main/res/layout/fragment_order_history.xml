<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">
    <RelativeLayout
        android:padding="@dimen/dip_10"
        android:background="@color/button_grey_color"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        >
        <TextView
            android:id="@+id/txtCustomerName"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:text="Customer Name"
            style="@style/Font15NormalWhite" />
    </RelativeLayout>
    <TextView
        android:id="@+id/lblTitle"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dip_10"
        android:gravity="center_horizontal"
        android:text="ORDER HISTORY"
        style="@style/Font25BoldGray" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/dip_10">
        <LinearLayout
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            >
            <TextView
                android:id="@+id/txtDeliver"
                android:layout_width="0dip"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginRight="@dimen/dip_5"
                android:paddingTop="@dimen/dip_10"
                android:paddingBottom="@dimen/dip_10"
                android:text="Orders"
                android:gravity="center"
                android:background="@color/vehicle_inventory_selected_color"
                style="@style/Font15NormalWhite" />
            <TextView
                android:id="@+id/txtReturns"
                android:layout_width="0dip"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dip_5"
                android:layout_marginRight="@dimen/dip_5"
                android:paddingTop="@dimen/dip_10"
                android:paddingBottom="@dimen/dip_10"
                android:text="Returns"
                android:gravity="center"
                android:background="@color/vehicle_inventory_normal_color"
                style="@style/Font15NormalWhite" />
            <TextView
                android:layout_width="0dip"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:id="@+id/blank"
                android:visibility="gone"/>
            <TextView
                android:layout_width="0dip"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:visibility="invisible"/>
        </LinearLayout>
        <ImageView
            android:layout_width="fill_parent"
            android:layout_height="@dimen/dip_1"
            android:layout_marginTop="@dimen/dip_10"
            android:background="@color/split_color" />
        <RelativeLayout
            android:layout_width="fill_parent"
            android:layout_height="0dip"
            android:layout_weight="1">
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:id="@+id/layoutContent"
                android:fillViewport="true">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="vertical">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="@dimen/dip_120"
                            android:layout_gravity="center"
                            android:layout_height="wrap_content" />
                        <LinearLayout
                            android:layout_gravity="center"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:id="@+id/layoutDate">

                        </LinearLayout>
                    </LinearLayout>
                    <ImageView
                        android:layout_width="fill_parent"
                        android:layout_height="@dimen/dip_1"
                        android:background="@color/split_color" />
                    <ListView
                        android:id="@+id/listItem"
                        android:divider="@null"
                        android:dividerHeight="0dip"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent" />
                </LinearLayout>

            </HorizontalScrollView>
            <TextView
                android:id="@+id/no_date_msg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/msg_no_data"
                android:layout_centerInParent="true"
                android:visibility="gone"
                style="@style/Font20NormalGray" />
        </RelativeLayout>

        <ImageView
            android:layout_width="fill_parent"
            android:layout_height="@dimen/dip_1"
            android:background="@color/split_color" />
        <LinearLayout
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button
                android:layout_marginTop="@dimen/dip_1"
                android:id="@+id/btnBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="@dimen/dip_10"
                android:layout_gravity="center_vertical"
                android:drawableLeft="@drawable/icon_left_arrow"
                android:background="@drawable/btn_button_grey_large"
                android:layout_alignParentLeft="true"
                android:layout_centerVertical="true"/>
            <View
                android:layout_width="0dip"
                android:layout_weight="1"
                android:layout_height="0dip" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
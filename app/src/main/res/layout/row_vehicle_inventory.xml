<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:paddingTop="@dimen/dip_2"
	android:paddingBottom="@dimen/dip_2"
	android:background="@drawable/table_normal">
	<TextView
		android:id="@+id/txtItemNo"
		android:layout_width="0dip"
		android:layout_weight="9"
		android:layout_height="wrap_content"
		android:text="123456789"
		style="@style/Font12NormalBlack"/>
	<TextView
		android:id="@+id/txtShortDesc"
		android:layout_width="0dip"
		android:layout_weight="20"
		android:layout_height="wrap_content"
		android:layout_marginLeft="@dimen/dip_2"
		android:text="Short Desc"
		style="@style/Font12NormalBlack"/>
	<TextView
		android:id="@+id/txtQty"
		android:layout_width="0dip"
		android:layout_weight="5"
		android:layout_height="wrap_content"
		android:layout_marginLeft="@dimen/dip_2"
		android:layout_marginRight="@dimen/dip_5"
		android:text="12345"
		android:gravity="right"
		style="@style/Font12NormalBlack"/>
</LinearLayout>
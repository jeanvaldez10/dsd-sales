<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:paddingTop="@dimen/dip_2"
	android:paddingBottom="@dimen/dip_2"
	android:orientation="vertical">
	<TextView
		android:id="@+id/txtTitle"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:text="Containers into store"
		style="@style/Font15NormalBlack"/>
	<LinearLayout
		android:layout_width="fill_parent"
		android:layout_height="wrap_content"
		android:layout_marginLeft="@dimen/dip_5">
		<TextView
			android:id="@+id/txtItemNo"
			android:layout_width="0dip"
			android:layout_weight="9"
			android:layout_height="wrap_content"
			android:layout_gravity="center_vertical"
			android:text="123456789"
			style="@style/Font15NormalBlack"/>
		<TextView
			android:id="@+id/txtShortDesc"
			android:layout_width="0dip"
			android:layout_weight="15"
			android:layout_height="wrap_content"
			android:layout_marginLeft="@dimen/dip_2"
			android:layout_gravity="center_vertical"
			android:text="Short Desc"
			style="@style/Font15NormalBlack"/>
		<EditText
			android:id="@+id/editQty"
			android:layout_width="0dip"
			android:layout_weight="5"
			android:layout_height="wrap_content"
			android:layout_marginLeft="@dimen/dip_2"
			android:layout_gravity="center_vertical"
			android:text="12345"
			android:singleLine="true"
			android:inputType="number"
			android:imeOptions="actionDone"
			style="@style/Font15NormalBlack"/>
	</LinearLayout>
</LinearLayout>
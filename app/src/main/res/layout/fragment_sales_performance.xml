<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="@dimen/dip_10"
    android:orientation="vertical">
    <TextView
        android:id="@+id/lblTitle"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dip_10"
        android:gravity="center_horizontal"
        android:text="SALES PERFORMANCE"
        style="@style/Font25BoldGray" />
    <ImageView
        android:layout_width="fill_parent"
        android:layout_height="@dimen/dip_1"
        android:layout_marginTop="@dimen/dip_10"
        android:background="@color/split_color" />
    <ScrollView

        android:layout_marginTop="@dimen/dip_10"
        android:layout_width="match_parent"
        android:layout_height="0dip"
        android:layout_weight="1">
        <LinearLayout

            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:id="@+id/lblCustomerVisits"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Font18BoldBlack"
                android:text="Customer Visits"/>
            <LinearLayout
                android:layout_marginTop="@dimen/dip_5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <View
                    android:layout_width="0dip"
                    android:layout_height="0dip"
                    android:layout_weight="1"/>
                <TextView
                    android:id="@+id/lblVisitsWithSales"
                    android:layout_width="0dip"
                    android:layout_height="wrap_content"
                    android:layout_weight="4"
                    android:text="Visits with Sales"
                    style="@style/Font15NormalBlack"/>
                <TextView
                    android:id="@+id/txtVisitsWithSales"
                    android:layout_width="0dip"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:text="12"
                    style="@style/Font15NormalBlack"/>
            </LinearLayout>
            <LinearLayout
                android:layout_marginTop="@dimen/dip_5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <View
                    android:layout_width="0dip"
                    android:layout_height="0dip"
                    android:layout_weight="1"/>
                <TextView
                    android:id="@+id/lblVisitsWithoutSales"
                    android:layout_width="0dip"
                    android:layout_height="wrap_content"
                    android:layout_weight="4"
                    android:text="Visits without Sales"
                    style="@style/Font15NormalBlack"/>
                <TextView
                    android:id="@+id/txtVisitsWithoutSales"
                    android:layout_width="0dip"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:text="3"
                    style="@style/Font15NormalBlack"/>
            </LinearLayout>
            <LinearLayout
                android:layout_marginTop="@dimen/dip_5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <View
                    android:layout_width="0dip"
                    android:layout_height="0dip"
                    android:layout_weight="1"/>
                <TextView
                    android:id="@+id/lblStrikeRate"
                    android:layout_width="0dip"
                    android:layout_height="wrap_content"
                    android:layout_weight="4"
                    android:text="Strike Rate"
                    style="@style/Font15NormalBlack"/>
                <TextView
                    android:id="@+id/txtStrikeRate"
                    android:layout_width="0dip"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:text="80%"
                    style="@style/Font15NormalBlack"/>
            </LinearLayout>
            <TextView
                android:layout_marginTop="@dimen/dip_10"
                android:id="@+id/lblSales"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Font18BoldBlack"
                android:text="Sales"/>
            <LinearLayout
                android:layout_marginTop="@dimen/dip_5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <View
                    android:layout_width="0dip"
                    android:layout_height="0dip"
                    android:layout_weight="1"/>
                <TextView
                    android:id="@+id/lblNetSalesValue"
                    android:layout_width="0dip"
                    android:layout_height="wrap_content"
                    android:layout_weight="4"
                    android:text="Net Sales Value"
                    style="@style/Font15NormalBlack"/>
                <TextView
                    android:id="@+id/txtNetSalesValue"
                    android:layout_width="0dip"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:text="$0.00"
                    style="@style/Font15NormalBlack"/>
            </LinearLayout>
            <LinearLayout
                android:layout_marginTop="@dimen/dip_5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <View
                    android:layout_width="0dip"
                    android:layout_height="0dip"
                    android:layout_weight="1"/>
                <TextView
                    android:id="@+id/lblTotalCustomerDeliveries"
                    android:layout_width="0dip"
                    android:layout_height="wrap_content"
                    android:layout_weight="4"
                    android:text="Total Customer Deliveries"
                    style="@style/Font15NormalBlack"/>
                <TextView
                    android:id="@+id/txtTotalCustomerDeliveries"
                    android:layout_width="0dip"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:text="100 cartons"
                    style="@style/Font15NormalBlack"/>
            </LinearLayout>
            <LinearLayout
                android:layout_marginTop="@dimen/dip_5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <View
                    android:layout_width="0dip"
                    android:layout_height="0dip"
                    android:layout_weight="1"/>
                <TextView
                    android:id="@+id/lblTotalFreeGoods"
                    android:layout_width="0dip"
                    android:layout_height="wrap_content"
                    android:layout_weight="4"
                    android:text="Total Free Goods"
                    style="@style/Font15NormalBlack"/>
                <TextView
                    android:id="@+id/txtTotalFreeGoods"
                    android:layout_width="0dip"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:text="1 cartons"
                    style="@style/Font15NormalBlack"/>
            </LinearLayout>
            <LinearLayout
                android:layout_marginTop="@dimen/dip_5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <View
                    android:layout_width="0dip"
                    android:layout_height="0dip"
                    android:layout_weight="1"/>
                <TextView
                    android:id="@+id/lblTotalCustomerReturns"
                    android:layout_width="0dip"
                    android:layout_height="wrap_content"
                    android:layout_weight="4"
                    android:text="Total Customer Returns"
                    style="@style/Font15NormalBlack"/>
                <TextView
                    android:id="@+id/txtTotalCustomerReturns"
                    android:layout_width="0dip"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:text="4 cartons"
                    style="@style/Font15NormalBlack"/>
            </LinearLayout>
            <LinearLayout
                android:layout_marginTop="@dimen/dip_5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <View
                    android:layout_width="0dip"
                    android:layout_height="0dip"
                    android:layout_weight="1"/>
                <TextView
                    android:id="@+id/lblNetDeliveries"
                    android:layout_width="0dip"
                    android:layout_height="wrap_content"
                    android:layout_weight="4"
                    android:text="Net Deliveries"
                    style="@style/Font15NormalBlack"/>
                <TextView
                    android:id="@+id/txtNetDeliveries"
                    android:layout_width="0dip"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:text="98 cartons"
                    style="@style/Font15NormalBlack"/>
            </LinearLayout>
            <TextView
                android:layout_marginTop="@dimen/dip_10"
                android:id="@+id/lblInventoryUtilisation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Font18BoldBlack"
                android:text="Inventory Utilisation"/>
            <LinearLayout
                android:layout_marginTop="@dimen/dip_5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <View
                    android:layout_width="0dip"
                    android:layout_height="0dip"
                    android:layout_weight="1"/>
                <TextView
                    android:id="@+id/lblEndingStock"
                    android:layout_width="0dip"
                    android:layout_height="wrap_content"
                    android:layout_weight="4"
                    android:text="Ending Stock"
                    style="@style/Font15NormalBlack"/>
                <TextView
                    android:id="@+id/txtEndingStock"
                    android:layout_width="0dip"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:text="203 cartons"
                    style="@style/Font15NormalBlack"/>
            </LinearLayout>
            <LinearLayout
                android:layout_marginTop="@dimen/dip_5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <View
                    android:layout_width="0dip"
                    android:layout_height="0dip"
                    android:layout_weight="1"/>
                <TextView
                    android:id="@+id/lblCustomerDeliveries"
                    android:layout_width="0dip"
                    android:layout_height="wrap_content"
                    android:layout_weight="4"
                    android:text="Customer Deliveries"
                    style="@style/Font15NormalBlack"/>
                <TextView
                    android:id="@+id/txtCustomerDeliveries"
                    android:layout_width="0dip"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:text="101 cartons"
                    style="@style/Font15NormalBlack"/>
            </LinearLayout>
            <LinearLayout
                android:layout_marginTop="@dimen/dip_5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <View
                    android:layout_width="0dip"
                    android:layout_height="0dip"
                    android:layout_weight="1"/>
                <TextView
                    android:id="@+id/lblUtilisation"
                    android:layout_width="0dip"
                    android:layout_height="wrap_content"
                    android:layout_weight="4"
                    android:text="Utilisation"
                    style="@style/Font15NormalBlack"/>
                <TextView
                    android:id="@+id/txtUtilisation"
                    android:layout_width="0dip"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:text="33 %"
                    style="@style/Font15NormalBlack"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dip_10"
        android:orientation="horizontal">
        <ImageView
            android:layout_width="0dip"
            android:layout_weight="1"
            android:layout_height="fill_parent" />
        <Button
            android:layout_gravity="center_vertical"
            android:id="@+id/btnDone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/btn_orange_large"
            android:text="Done"
            style="@style/Font20NormalWhite" />
    </LinearLayout>
</LinearLayout>
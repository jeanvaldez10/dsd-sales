<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:paddingTop="@dimen/dip_2"
	android:paddingBottom="@dimen/dip_2"
	android:background="@color/white_color"
	>
	<CheckBox
		android:id="@+id/chkSelect"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_gravity="center_vertical"
		style="@style/Font12NormalBlack"/>
	<TextView
		android:id="@+id/txtInvoiceDate"
		android:layout_width="0dip"
		android:layout_weight="6"
		android:layout_height="wrap_content"
		android:layout_marginLeft="@dimen/dip_2"
		android:layout_gravity="center_vertical"
		android:text="12/04/2016"
		style="@style/Font12NormalBlack"/>
	<TextView
		android:layout_width="0dip"
		android:id="@+id/txtInvNumber"
		android:layout_height="wrap_content"
		android:layout_weight="6"
		android:text="1234567890"
		android:layout_gravity="center_vertical"
		style="@style/Font12NormalBlack"
		android:layout_marginLeft="@dimen/dip_2"/>
	<TextView
		android:id="@+id/txtItemType"
		android:layout_width="0dip"
		android:layout_weight="3"
		android:layout_height="wrap_content"
		android:layout_gravity="center_vertical"
		android:gravity="center"
		android:text="INV"
		style="@style/Font12NormalBlack" />
	<TextView
		android:id="@+id/lblCurrencySymbol"
		android:layout_width="0dip"
		android:layout_weight="1"
		android:layout_height="wrap_content"
		android:layout_gravity="center_vertical"
		android:layout_marginLeft="@dimen/dip_5"
		android:text="$"
		android:gravity="right"
		style="@style/Font12NormalBlack" />
	<TextView
		android:id="@+id/editPrice"
		android:layout_width="0dip"
		android:layout_weight="5"
		android:layout_height="wrap_content"
		android:layout_marginLeft="@dimen/dip_2"
		android:layout_gravity="center_vertical"
		android:text="99999.99"
		android:gravity="center_vertical|right"

		style="@style/Font12NormalBlack"/>
</LinearLayout>

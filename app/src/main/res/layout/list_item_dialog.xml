<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/ListItem"
    android:id="@+id/root"
    android:paddingLeft="@dimen/dip_16"
    android:paddingRight="@dimen/dip_16"
    tools:ignore="RtlHardcoded">
    <ImageView
        android:layout_width="@dimen/dip_10"
        android:layout_height="@dimen/dip_10"
        android:layout_gravity="center"
        android:layout_marginRight="@dimen/dip_5"
        android:layout_marginLeft="@dimen/dip_5"
        android:id="@+id/status"
        android:visibility="gone"
        android:src="@drawable/circle_red"/>
    <LinearLayout
        style="@style/WeightWidth"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/text_dialog_name"
            style="@style/DialogNameStyle"
            tools:text="Room name" />

        <TextView
            android:id="@+id/text_dialog_last_message"
            style="@style/DialogLastMessageStyle"
            tools:text="Long last message to see how margin on the right side works" />
    </LinearLayout>

    <TextView
        android:id="@+id/text_dialog_unread_count"
        style="@style/DialogUnreadCounterStyle"
        android:visibility="visible"
        tools:text="4" />
</LinearLayout>
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">
    <RelativeLayout
        android:padding="@dimen/dip_10"
        android:background="@color/button_grey_color"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        >
        <TextView
            android:id="@+id/txtCustomerName"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:text="Customer Name"
            style="@style/Font15NormalWhite" />
    </RelativeLayout>
    <TextView
        android:id="@+id/lblTitle"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dip_10"
        android:gravity="center_horizontal"
        android:text="Customer Diary"
        android:textAllCaps="true"
        style="@style/Font25BoldGray" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/dip_10">
        <ImageView
            android:layout_width="fill_parent"
            android:layout_height="@dimen/dip_1"
            android:background="@color/split_color" />
        <LinearLayout
            android:layout_width="fill_parent"
            android:layout_height="0dip"
            android:layout_weight="1"
            android:layout_marginTop="@dimen/dip_10"
            android:orientation="vertical">
            <TextView
                android:id="@+id/txtNoteType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dip_40"
                android:layout_marginRight="@dimen/dip_40"
                android:drawableRight="@drawable/icon_drop_down"
                android:layout_gravity="center_vertical"
                android:text="Note Type"
                android:background="@drawable/btn_grey_large"
                style="@style/Font15NormalBlack" />
            <EditText
                android:id="@+id/editMessage"
                android:padding="@dimen/dip_10"
                style="@style/Font15NormalBlack"
                android:gravity="left|top"
                android:background="@drawable/bg_edit_black"
                android:layout_margin="@dimen/dip_20"
                android:layout_width="match_parent"
                android:layout_height="0dip"
                android:layout_weight="1"/>
            <TextView
                android:singleLine="true"
                android:id="@+id/txtAttachment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dip_40"
                android:layout_marginRight="@dimen/dip_40"
                android:layout_gravity="center_vertical"
                android:text="Attachment"
                android:background="@drawable/btn_grey_large"
                style="@style/Font15NormalBlack" />
        </LinearLayout>
        <ImageView
            android:layout_width="fill_parent"
            android:layout_height="@dimen/dip_1"
            android:layout_marginTop="@dimen/dip_10"
            android:background="@color/split_color" />
        <RelativeLayout
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dip_10"
            android:orientation="horizontal">
            <Button
                android:id="@+id/btnBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="@dimen/dip_10"
                android:layout_centerVertical="true"
                android:drawableLeft="@drawable/icon_left_arrow"
                android:background="@drawable/btn_button_grey_large" />
            <Button
                android:layout_centerVertical="true"
                android:id="@+id/btnDone"
                android:layout_width="@dimen/dip_100"
                android:layout_height="wrap_content"
                android:paddingTop="@dimen/dip_10"
                android:paddingBottom="@dimen/dip_10"
                android:paddingLeft="@dimen/dip_20"
                android:paddingRight="@dimen/dip_20"
                android:layout_alignParentRight="true"
                android:background="@drawable/btn_orange_large"
                android:text="Done"
                style="@style/Font20NormalWhite" />
        </RelativeLayout>
    </LinearLayout>

</LinearLayout>
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/ListItem"
    tools:ignore="RtlHardcoded">

    <ImageView
        android:layout_width="@dimen/dip_10"
        android:layout_height="@dimen/dip_10"
        android:src="@drawable/circle_red"
        android:id="@+id/status"
        android:layout_marginLeft="@dimen/dip_5"
        android:layout_marginRight="@dimen/dip_5"/>
    <TextView
        android:id="@+id/text_user_login"
        style="@style/UserTitleStyle" />

    <CheckBox
        android:id="@+id/checkbox_user"
        style="@style/UserCheckboxStyle" />

</LinearLayout>
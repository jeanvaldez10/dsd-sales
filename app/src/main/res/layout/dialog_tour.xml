<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:layout_margin="@dimen/dip_20"
	android:layout_gravity="center"
	android:background="@color/white_color"
	android:orientation="vertical">
	
	<RelativeLayout
		android:layout_width="match_parent"
		android:layout_height="0dip"
		android:layout_weight="1.5">
		<androidx.viewpager.widget.ViewPager
			android:layout_marginTop="@dimen/dip_40"
			android:id="@+id/viewPager"
			android:visibility="visible"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			/>
		<dsd.dsdvansales.views.GalleryNavigator
			android:layout_margin="10dp"
			android:id="@+id/navigator"
			android:layout_centerHorizontal="true"
			android:layout_alignParentBottom="true"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"/>
		<TextView
			android:id="@+id/btnSkip"
			android:padding="@dimen/dip_15"
			android:text="Skip"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			style="@style/Font12BoldBlack"
			/>
		<TextView
			android:id="@+id/btnNext"
			android:layout_alignParentRight="true"
			android:padding="@dimen/dip_15"
			android:text="Next"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			style="@style/Font12BoldBlack"
			/>
	</RelativeLayout>
	<View
		android:layout_width="match_parent"
		android:layout_height="@dimen/dip_1"
		android:backgroundTint="@color/text_color_dark_grey"/>
	<TextView
		android:gravity="center"
		android:id="@+id/txtTitle"
		android:padding="@dimen/dip_10"
		android:layout_margin="@dimen/dip_10"
		style="@style/Font15BoldBlack"
		android:layout_gravity="center"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content">

	</TextView>
	<RelativeLayout
		android:layout_width="match_parent"
		android:layout_height="0dip"
		android:layout_weight="1">
		<TextView
			android:id="@+id/txtDescription"
			android:padding="@dimen/dip_10"
			style="@style/Font12NormalBlack"
			android:gravity="center_horizontal"
			android:layout_gravity="center"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:layout_weight="1">

		</TextView>
		<CheckBox
			android:layout_marginBottom="@dimen/dip_10"
			android:layout_alignParentBottom="true"
			android:id="@+id/btnDontShowAgain"
			android:layout_alignParentRight="true"
			android:padding="@dimen/dip_15"
			android:text="Don't show again"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			style="@style/Font12BoldBlack"
			/>
	</RelativeLayout>

</LinearLayout>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="fill_parent"
	android:layout_height="wrap_content"
	android:layout_margin="@dimen/dip_20"
	android:layout_gravity="center"
	android:background="@color/white_color"
	android:orientation="vertical">
	<TextView
		android:id="@+id/txtTitle"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_margin="@dimen/dip_20"
		android:layout_gravity="center_horizontal"
		android:text="Batch Code"
		style="@style/Font20NormalBlack" />
	<TextView
		android:id="@+id/txtDescription"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_gravity="center_horizontal"
		android:text="Please complete batch code"
		style="@style/Font12NormalBlack" />
	<ListView
		android:id="@+id/list"
		android:layout_weight="1"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"/>

	<RelativeLayout
		android:id="@+id/layoutOverrideCode"
		android:layout_width="fill_parent"
		android:layout_height="wrap_content"
		android:layout_margin="@dimen/dip_20"
		android:orientation="horizontal">
		<Button
			android:id="@+id/btnLeft"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_alignParentLeft="true"
			android:background="@drawable/btn_button_grey_large"
			android:text="Enter"
			style="@style/Font20NormalWhite" />
		<Button
			android:id="@+id/btnRight"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_alignParentRight="true"
			android:background="@drawable/btn_orange_large"
			android:text="Return"
			style="@style/Font20NormalWhite" />
	</RelativeLayout>
</LinearLayout>
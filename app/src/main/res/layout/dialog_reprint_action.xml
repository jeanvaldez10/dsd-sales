<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="fill_parent"
	android:layout_height="wrap_content"
	android:layout_margin="@dimen/dip_20"
	android:layout_gravity="center"
	android:padding="@dimen/dip_20"
	android:background="@color/white_color"
	android:orientation="vertical">
	<TextView
		android:id="@+id/txtTitle"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_gravity="center_horizontal"
		android:text="SELECT ACTION"
		android:gravity="center_horizontal"
		style="@style/Font25BoldBlack" />
	<LinearLayout
		android:id="@+id/layoutView"
		android:layout_width="fill_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="@dimen/dip_10"
		android:background="@drawable/btn_white_medium">
		<ImageView
			android:layout_width="@dimen/dip_10"
			android:layout_height="@dimen/dip_10"
			android:layout_gravity="center_vertical"
			android:background="@drawable/circle_orange" />
		<TextView
			android:id="@+id/txtView"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginLeft="@dimen/dip_10"
			android:text="VIEW INVOICE"
			style="@style/Font20NormalBlack" />
	</LinearLayout>
	<LinearLayout
		android:id="@+id/layoutViewVoid"
		android:layout_width="fill_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="@dimen/dip_10"
		android:background="@drawable/btn_white_medium">
		<ImageView
			android:layout_width="@dimen/dip_10"
			android:layout_height="@dimen/dip_10"
			android:layout_gravity="center_vertical"
			android:background="@drawable/circle_orange" />
		<TextView
			android:id="@+id/txtViewVoid"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginLeft="@dimen/dip_10"
			android:text="VIEW VOID"
			style="@style/Font20NormalBlack" />
	</LinearLayout>
	<LinearLayout
		android:id="@+id/layoutPrint"
		android:layout_width="fill_parent"
		android:layout_height="wrap_content"
		android:background="@drawable/btn_white_medium">
		<ImageView
			android:layout_width="@dimen/dip_10"
			android:layout_height="@dimen/dip_10"
			android:layout_gravity="center_vertical"
			android:background="@drawable/circle_orange" />
		<TextView
			android:id="@+id/txtPrint"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginLeft="@dimen/dip_10"
			android:text="PRINT INVOICE"
			style="@style/Font20NormalBlack" />
	</LinearLayout>
	<LinearLayout
		android:id="@+id/layoutVoid"
		android:layout_width="fill_parent"
		android:layout_height="wrap_content"
		android:background="@drawable/btn_white_medium">
		<ImageView
			android:layout_width="@dimen/dip_10"
			android:layout_height="@dimen/dip_10"
			android:layout_gravity="center_vertical"
			android:background="@drawable/circle_orange" />
		<TextView
			android:id="@+id/txtVoid"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginLeft="@dimen/dip_10"
			android:text="PRINT VOID"
			style="@style/Font20NormalBlack" />
	</LinearLayout>
	<RelativeLayout
		android:layout_width="fill_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="@dimen/dip_10"
		android:orientation="horizontal">
		<Button
			android:id="@+id/btnReturn"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_alignParentRight="true"
			android:background="@drawable/btn_orange_large"
			android:text="Return"
			style="@style/Font20NormalWhite" />
	</RelativeLayout>
</LinearLayout>
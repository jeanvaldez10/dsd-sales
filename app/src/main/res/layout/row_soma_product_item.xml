<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:paddingTop="@dimen/dip_10"
	android:paddingBottom="@dimen/dip_10"
	android:orientation="vertical"
	android:background="@drawable/table_normal"
	>
	<LinearLayout
		android:orientation="horizontal"
		android:layout_width="match_parent"
		android:layout_height="wrap_content">
		<TextView
			android:id="@+id/txtItemNo"
			android:layout_width="0dip"
			android:layout_weight="9"
			android:layout_height="wrap_content"
			android:text="123456789"
			style="@style/Font12NormalBlack"/>
		<TextView
			android:breakStrategy="simple"
			android:hyphenationFrequency="none"
			android:id="@+id/txtDescription"
			android:layout_width="0dip"
			android:layout_weight="15"
			android:layout_height="wrap_content"
			android:layout_marginLeft="@dimen/dip_2"
			android:text="Description"
			style="@style/Font12NormalBlack"/>

		<TextView
			android:breakStrategy="simple"
			android:hyphenationFrequency="none"
			android:id="@+id/txtCalculation"
			android:layout_width="0dip"
			android:layout_weight="15"
			android:layout_height="wrap_content"
			android:layout_marginLeft="@dimen/dip_2"
			android:text="12345"
			style="@style/Font12NormalBlack"/>
	</LinearLayout>
</LinearLayout>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:paddingTop="@dimen/dip_2"
	android:background="@color/white_color"
	android:paddingBottom="@dimen/dip_2"
	>
	<TextView
		android:id="@+id/txtItemNo"
		android:layout_width="wrap_content"
		android:layout_weight="5"
		android:layout_height="wrap_content"
		android:layout_gravity="center_vertical"
		android:text="1234567890123"
		style="@style/Font12NormalBlack"/>
	<TextView
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		style="@style/Font12NormalBlack"
		android:text="* "
		android:id="@+id/txtFreeItem"
		android:visibility="invisible"
		android:layout_gravity="center_vertical"/>
	<TextView
		android:id="@+id/txtShortDesc"
		android:layout_width="wrap_content"
		android:layout_weight="8"
		android:layout_height="wrap_content"
		android:layout_marginLeft="@dimen/dip_2"
		android:layout_gravity="center_vertical"
		android:text="Short Desc"
		style="@style/Font12NormalBlack"/>
	<TextView
		android:layout_width="wrap_content"
		android:id="@+id/txtItemType"
		android:layout_height="wrap_content"
		android:layout_weight="2"
		android:text="BBK"
		android:layout_gravity="center_vertical"
		style="@style/Font12NormalBlack"
		android:layout_marginLeft="@dimen/dip_2"/>
	<TextView
		android:id="@+id/txtQty"
		android:layout_width="wrap_content"
		android:layout_weight="2"
		android:layout_height="wrap_content"
		android:layout_gravity="center_vertical"
		android:text="4/8"
		android:gravity="center"
		style="@style/Font12NormalBlack" />
	<TextView
		android:id="@+id/lblCurrencySymbol"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_gravity="center_vertical"
		android:layout_marginLeft="@dimen/dip_5"
		android:text="$"
		style="@style/Font12NormalBlack" />
	<EditText
		android:id="@+id/editPrice"
		android:layout_width="wrap_content"
		android:layout_weight="5"
		android:layout_height="wrap_content"
		android:layout_marginLeft="@dimen/dip_2"
		android:layout_gravity="center_vertical"
		android:text="12345"
		android:gravity="center_vertical"
		android:singleLine="true"
		android:inputType="number"
		android:imeOptions="actionDone"
		style="@style/Font12NormalBlack"/>
</LinearLayout>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical">
	<RelativeLayout
		android:background="@color/button_grey_color"
		android:padding="@dimen/dip_10"
		android:layout_width="match_parent"
		android:layout_height="wrap_content">
		<TextView
			android:id="@+id/txtWelcome"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="Hi DSDuser"
			style="@style/Font15NormalWhite" />
	</RelativeLayout>
	<TextView
		android:id="@+id/lblTitle"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_marginTop="@dimen/dip_10"
		android:layout_gravity="center_horizontal"
		android:text="MESSAGE BOARD"
		style="@style/Font25BoldGray" />
	<ImageView
		android:layout_width="fill_parent"
		android:layout_height="@dimen/dip_1"
		android:layout_marginTop="@dimen/dip_10"
		android:layout_marginLeft="@dimen/dip_10"
		android:layout_marginRight="@dimen/dip_10"
		android:background="@color/split_color" />
	<LinearLayout
		android:layout_width="fill_parent"
		android:layout_height="0dip"
		android:layout_weight="1"
		android:layout_margin="@dimen/dip_10"
		android:orientation="vertical">
		<ListView
			android:id="@+id/listView"
			android:layout_width="fill_parent"
			android:layout_height="fill_parent"
			android:dividerHeight="@dimen/dip_1"
			android:divider="@color/split_color" />
		<TextView
			android:id="@+id/txtNoData"
			android:layout_width="fill_parent"
			android:layout_height="fill_parent"
			android:text="@string/msg_no_data"
			android:gravity="center"
			android:visibility="gone"
			style="@style/Font20NormalGray" />
	</LinearLayout>
	<Button
		android:id="@+id/btnReturn"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_margin="@dimen/dip_10"
		android:layout_gravity="right"
		android:background="@drawable/btn_orange_large"
		android:text="Return"
		style="@style/Font20NormalWhite" />
</LinearLayout>
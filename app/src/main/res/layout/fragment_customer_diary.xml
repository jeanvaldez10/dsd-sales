<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">
    <RelativeLayout
        android:padding="@dimen/dip_10"
        android:background="@color/button_grey_color"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:id="@+id/txtCustomerName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Customer Name"
            style="@style/Font15NormalWhite" />
    </RelativeLayout>
    <TextView
        android:id="@+id/lblTitle"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dip_10"
        android:gravity="center_horizontal"
        android:text="Customer Diary"
        android:textAllCaps="true"
        style="@style/Font25BoldGray" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="@dimen/dip_10"
        android:orientation="vertical">
        <ImageView
            android:layout_width="fill_parent"
            android:layout_height="@dimen/dip_1"
            android:background="@color/split_color" />
        <LinearLayout
            android:layout_width="fill_parent"
            android:layout_height="0dip"
            android:layout_weight="1"
            android:layout_marginTop="@dimen/dip_10"
            android:orientation="vertical">
            <ListView
                android:id="@+id/listView"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:dividerHeight="@dimen/dip_1"
                android:divider="@color/split_color" />
            <TextView
                android:id="@+id/txtNoData"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:text="@string/msg_no_data"
                android:gravity="center"
                android:visibility="gone"
                style="@style/Font20NormalGray" />
        </LinearLayout>
        <RelativeLayout
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dip_10"
            android:orientation="horizontal">
            <Button
                android:id="@+id/btnBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="@dimen/dip_10"
                android:layout_centerVertical="true"
                android:drawableLeft="@drawable/icon_left_arrow"
                android:background="@drawable/btn_button_grey_large" />
            <Button
                android:id="@+id/btnAdd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginRight="@dimen/dip_20"
                android:layout_gravity="center_vertical"
                android:layout_centerHorizontal="true"
                android:drawableLeft="@drawable/icon_add_customer"
                android:background="@drawable/btn_white_small" />
        </RelativeLayout>
    </LinearLayout>

</LinearLayout>
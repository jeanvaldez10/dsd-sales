<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="fill_parent"
	android:layout_height="wrap_content"
	android:layout_margin="@dimen/dip_20"
	android:paddingTop="@dimen/dip_10"
	android:layout_gravity="center"
	android:background="@color/white_color"
	android:orientation="vertical">
	<TextView
		android:id="@+id/txtTitle"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_marginTop="@dimen/dip_10"
		android:layout_gravity="center_horizontal"
		android:text="Equipment Note"
		android:gravity="center_horizontal"
		style="@style/Font25BoldBlack" />
	<ScrollView
		android:layout_marginTop="@dimen/dip_10"
		android:padding="@dimen/dip_10"
		android:minHeight="@dimen/dip_150"
		android:layout_width="match_parent"
		android:layout_weight="1"
		android:layout_height="0dip">
		<LinearLayout
			android:id="@+id/layoutContent"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical">

		</LinearLayout>
	</ScrollView>

	<RelativeLayout
		android:layout_width="fill_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="@dimen/dip_20"
		android:layout_marginBottom="@dimen/dip_20"
		android:layout_marginLeft="@dimen/dip_10"
		android:layout_marginRight="@dimen/dip_10"
		android:orientation="horizontal">
		<Button
			android:id="@+id/btnCancel"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:paddingTop="@dimen/dip_10"
			android:paddingBottom="@dimen/dip_10"
			android:paddingLeft="@dimen/dip_20"
			android:paddingRight="@dimen/dip_20"
			android:layout_alignParentLeft="true"
			android:background="@drawable/btn_button_grey_large"
			android:text="Cancel"
			style="@style/Font20NormalWhite" />

		<Button
			android:id="@+id/btnCompleted"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_alignParentRight="true"
			android:background="@drawable/btn_orange_large"
			android:text="Completed"
			style="@style/Font20NormalWhite" />
	</RelativeLayout>
</LinearLayout>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="fill_parent"
	android:layout_height="wrap_content"
	android:padding="@dimen/dip_10"
	android:background="@drawable/table_normal">
	<LinearLayout
		android:layout_width="0dip"
		android:layout_weight="1"
		android:layout_height="wrap_content"
		android:layout_marginLeft="@dimen/dip_10"
		android:layout_marginRight="@dimen/dip_5"
		android:orientation="vertical">
		<TextView
			android:id="@+id/txtCustomerName"
			android:layout_width="fill_parent"
			android:layout_height="wrap_content"
			android:text="Customer Name"
			style="@style/Font15BoldBlack" />
		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="horizontal">
			<TextView
				android:id="@+id/txtCity"
				android:layout_width="0dip"
				android:layout_weight="1"
				android:layout_height="wrap_content"
				android:text="City Name"
				style="@style/Font10NormalBlack" />
			<TextView
				android:id="@+id/txtZip"
				android:layout_width="0dip"
				android:layout_weight="1"
				android:layout_height="wrap_content"
				android:text="Zip Name"
				style="@style/Font10NormalBlack" />
		</LinearLayout>
		<TextView
			android:id="@+id/txtCustomerNo"
			android:layout_width="fill_parent"
			android:layout_height="wrap_content"
			android:text="Customer"
			style="@style/Font10NormalBlack" />
	</LinearLayout>
	<Button
		android:id="@+id/btnAdd"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_marginLeft="@dimen/dip_10"
		android:layout_gravity="center_vertical"
		android:paddingLeft="@dimen/dip_20"
		android:paddingRight="@dimen/dip_20"
		android:paddingTop="@dimen/dip_10"
		android:paddingBottom="@dimen/dip_10"
		android:background="@drawable/btn_orange_large"
		android:text="Add"
		style="@style/Font15NormalWhite" />
</LinearLayout>

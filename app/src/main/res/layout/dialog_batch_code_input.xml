<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="fill_parent"
	android:layout_height="wrap_content"
	android:layout_margin="@dimen/dip_20"
	android:paddingTop="@dimen/dip_10"
	android:layout_gravity="center"
	android:background="@color/white_color"
	android:orientation="vertical">
	<TextView
		android:id="@+id/txtTitle"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_marginTop="@dimen/dip_10"
		android:layout_gravity="center_horizontal"
		android:text="Batch Code"
		style="@style/Font25BoldBlack" />
	<TextView
		android:id="@+id/txtMessage"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_marginTop="@dimen/dip_10"
		android:layout_gravity="center_horizontal"
		android:text="Enter the batch codes for the delivered items"
		style="@style/Font15NormalBlack" />
	<ListView
		android:id="@+id/list"
		android:dividerHeight="0dp"
		android:divider="@color/transparent_color"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_weight="1">

	</ListView>
	<RelativeLayout
		android:layout_width="fill_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="@dimen/dip_20"
		android:layout_marginBottom="@dimen/dip_20"
		android:layout_marginLeft="@dimen/dip_10"
		android:layout_marginRight="@dimen/dip_10"
		android:orientation="horizontal">
		<Button
			android:id="@+id/btnConfirm"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_centerInParent="true"
			android:background="@drawable/btn_orange_large"
			android:text="Confirm"
			style="@style/Font20NormalWhite" />
	</RelativeLayout>
</LinearLayout>
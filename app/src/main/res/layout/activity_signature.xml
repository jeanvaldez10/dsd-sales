<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
	android:id="@+id/whole_layout"
	xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="@dimen/dip_300"
	android:layout_height="@dimen/dip_350"
	android:orientation="vertical"
	android:background="@color/white_pressed_color">
	<LinearLayout
		android:layout_width="fill_parent"
		android:layout_height="wrap_content"
		android:layout_margin="@dimen/dip_10"
		android:orientation="horizontal">
		<Button
			android:id="@+id/btnBack"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginLeft="@dimen/dip_10"
			android:padding="@dimen/dip_10"
			android:text=" Exit "
			android:background="@drawable/btn_button_grey_large"
			style="@style/Font15NormalWhite" />
		<dsd.dsdvansales.views.ClickEffectImageView
			android:id="@+id/btnRotate"
			android:layout_marginLeft="@dimen/dip_10"
			android:layout_gravity="center"
			android:layout_width="@dimen/dip_40"
			android:layout_height="@dimen/dip_40"
			android:src="@drawable/icon_rotate"/>
		<ImageView
			android:layout_width="0dip"
			android:layout_weight="1"
			android:layout_height="fill_parent" />
		<Button
			android:id="@+id/btnClear"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginLeft="@dimen/dip_10"
			android:padding="@dimen/dip_10"
			android:text="Clear"
			android:background="@drawable/btn_button_grey_large"
			style="@style/Font15NormalWhite" />
		<Button
			android:id="@+id/btnSave"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginLeft="@dimen/dip_10"
			android:padding="@dimen/dip_10"
			android:text="Save"
			android:background="@drawable/btn_orange_large"
			style="@style/Font15NormalWhite" />
	</LinearLayout>
	<LinearLayout
		android:orientation="horizontal"
		android:id="@+id/layoutSignature"
		android:layout_width="fill_parent"
		android:layout_height="fill_parent"
		android:layout_margin="@dimen/dip_10"
		android:background="@color/white_color" />
</LinearLayout>
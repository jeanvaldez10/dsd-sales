<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="fill_parent"
	android:layout_height="wrap_content"
	android:layout_margin="@dimen/dip_20"
	android:padding="@dimen/dip_20"
	android:layout_gravity="center"
	android:background="@color/white_color"
	android:orientation="vertical">
	<TextView
		android:id="@+id/txtTitle"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_gravity="center_horizontal"
		android:text="ADJUST CONSIGNMENT"
		android:gravity="center_horizontal"
		style="@style/Font25BoldBlack" />
	<TextView
		android:id="@+id/txtAddStock"
		android:layout_width="fill_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="@dimen/dip_15"
		android:drawableRight="@drawable/icon_check_on"
		android:text="Add Stock to Shelf"
		android:gravity="center_vertical"
		android:background="@drawable/table_normal"
		style="@style/Font15NormalBlack" />
	<TextView
		android:id="@+id/txtRemoveStock"
		android:layout_width="fill_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="@dimen/dip_10"
		android:drawableRight="@drawable/icon_check_off"
		android:text="Remove Stock from Shelf"
		android:gravity="center_vertical"
		android:background="@drawable/table_normal"
		style="@style/Font15NormalBlack" />
	<TextView
		android:id="@+id/txtRemoveDamagedStock"
		android:layout_width="fill_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="@dimen/dip_10"
		android:drawableRight="@drawable/icon_check_off"
		android:text="Remove Damaged Stock from Shelf"
		android:gravity="center_vertical"
		android:background="@drawable/table_normal"
		style="@style/Font15NormalBlack" />
	<RelativeLayout
		android:layout_width="fill_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="@dimen/dip_20"
		android:orientation="horizontal">
		<Button
			android:id="@+id/btnReturn"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_alignParentLeft="true"
			android:background="@drawable/btn_button_grey_large"
			android:text="Return"
			style="@style/Font20NormalWhite" />
		<Button
			android:id="@+id/btnSelect"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_alignParentRight="true"
			android:background="@drawable/btn_orange_large"
			android:text="Select"
			style="@style/Font20NormalWhite" />
	</RelativeLayout>
</LinearLayout>
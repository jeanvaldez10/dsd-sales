<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">
    <RelativeLayout
        android:padding="@dimen/dip_10"
        android:background="@color/button_grey_color"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:id="@+id/lblCustomerName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Customer Name"
            style="@style/Font15NormalWhite" />
    </RelativeLayout>
    <TextView
        android:id="@+id/lblTitle"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dip_10"
        android:gravity="center_horizontal"
        android:text="EQUIPMENT REPAIR"
        android:textAllCaps="true"
        style="@style/Font25BoldGray" />
    <ImageView
        android:layout_width="fill_parent"
        android:layout_height="@dimen/dip_1"
        android:layout_marginTop="@dimen/dip_10"
        android:layout_marginLeft="@dimen/dip_10"
        android:layout_marginRight="@dimen/dip_10"
        android:background="@color/split_color" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="@dimen/dip_10"
        android:orientation="vertical">
        <dsd.dsdvansales.views.ScrollViewExt
            android:layout_marginTop="@dimen/dip_10"
            android:layout_width="match_parent"
            android:layout_height="0dip"
            android:id="@+id/scroll_terms"
            android:layout_weight="1">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/dip_10"
                android:lineSpacingExtra="@dimen/dip_5"
                android:id="@+id/txtTerms"
                style="@style/Font15NormalBlack"/>
        </dsd.dsdvansales.views.ScrollViewExt>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dip_10"
            android:orientation="vertical">
            <TextView
                android:layout_marginTop="@dimen/dip_10"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Agreed by"
                android:id="@+id/lblAgreedBy"
                style="@style/Font15NormalBlack"/>
            <EditText
                android:id="@+id/editName"
                android:inputType="textPersonName"
                android:layout_marginTop="@dimen/dip_5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Name"
                android:gravity="center"
                style="@style/Font15NormalBlack"/>
            <EditText
                android:id="@+id/editNameDisable"
                android:enabled="false"
                android:focusable="false"
                android:visibility="gone"
                android:inputType="textPersonName"
                android:layout_marginTop="@dimen/dip_5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Name"
                android:gravity="center"
                style="@style/Font15NormalBlack"/>
            <EditText
                android:id="@+id/editSignature"
                android:inputType="textPersonName"
                android:layout_marginTop="@dimen/dip_5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Name"
                android:gravity="center"
                style="@style/Font15NormalBlack"/>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                >
                <dsd.dsdvansales.views.ClickEffectImageView
                    android:id="@+id/btnSignature"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignTop="@+id/lblSignature"
                    android:layout_alignBottom="@+id/lblSignature"
                    android:layout_alignLeft="@+id/lblSignature"
                    android:layout_alignRight="@+id/lblSignature"
                    android:scaleType="fitXY"
                    />
                <EditText
                    android:id="@+id/editSignatureDisable"
                    android:enabled="false"
                    android:inputType="textPersonName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignTop="@+id/lblSignature"
                    android:layout_alignBottom="@+id/lblSignature"
                    android:layout_alignLeft="@+id/lblSignature"
                    android:layout_alignRight="@+id/lblSignature"
                    android:focusable="false"
                    android:visibility="gone"
                    android:gravity="center"
                    style="@style/Font15NormalBlack"/>
                <TextView
                    android:paddingTop="@dimen/dip_10"
                    android:paddingBottom="@dimen/dip_15"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/lblSignature"
                    android:gravity="center"
                    android:text="Signature"
                    style="@style/Font15NormalGray"/>
            </RelativeLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_marginTop="@dimen/dip_10"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <Button
                android:id="@+id/btnReturn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:background="@drawable/btn_button_grey_large"
                android:text="Return"
                style="@style/Font20NormalWhite" />
            <ImageView
                android:layout_width="0dip"
                android:layout_weight="1"
                android:layout_height="wrap_content" />
            <Button
                android:id="@+id/btnConfirm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:background="@drawable/btn_orange_large"
                android:text="Collect Deposit"
                style="@style/Font20NormalWhite" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>

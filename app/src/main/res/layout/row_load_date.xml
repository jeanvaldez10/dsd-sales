<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:paddingTop="@dimen/dip_2"
	android:paddingBottom="@dimen/dip_2"
	android:orientation="horizontal"
	>
	<CheckBox
		android:id="@+id/chkDetail"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_gravity="center_vertical"
		style="@style/Font15NormalBlack"/>
	<LinearLayout
		android:layout_gravity="center_vertical"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="vertical">
		<LinearLayout
			android:layout_width="match_parent"
			android:orientation="horizontal"
			android:layout_height="wrap_content">
			<TextView
				android:id="@+id/txtDetail"
				android:layout_width="0dip"
				android:layout_weight="4"
				android:maxLength="20"
				android:singleLine="true"
				style="@style/Font12NormalBlack"
				android:layout_height="wrap_content">
			</TextView>
			<TextView
				android:id="@+id/txtLoad"
				android:layout_width="0dip"
				android:layout_weight="2"
				android:layout_height="wrap_content"
				android:layout_gravity="center_vertical"
				android:gravity="left"
				style="@style/Font12NormalBlack"/>
			<TextView
				android:id="@+id/txtDay"
				android:layout_width="0dip"
				android:layout_weight="2"
				android:layout_height="wrap_content"
				android:layout_gravity="center_vertical"
				android:gravity="left"
				style="@style/Font12NormalBlack" />
		</LinearLayout>
		<LinearLayout
			android:layout_width="match_parent"
			android:orientation="horizontal"
			android:layout_height="wrap_content">
			<TextView
				android:id="@+id/txtBay"
				android:layout_width="0dip"
				android:layout_weight="4"
				android:singleLine="true"
				style="@style/Font12NormalBlack"
				android:layout_height="wrap_content">
			</TextView>
			<TextView
				android:id="@+id/txtUser1"
				android:layout_width="0dip"
				android:layout_weight="2"
				android:layout_height="wrap_content"
				android:layout_gravity="center_vertical"
				android:gravity="left"
				style="@style/Font12NormalBlack"/>
			<TextView
				android:id="@+id/txtUser2"
				android:layout_width="0dip"
				android:layout_weight="2"
				android:layout_height="wrap_content"
				android:layout_gravity="center_vertical"
				android:gravity="left"
				style="@style/Font12NormalBlack" />
		</LinearLayout>
	</LinearLayout>




</LinearLayout>

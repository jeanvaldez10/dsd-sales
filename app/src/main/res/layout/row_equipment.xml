<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="fill_parent"
	android:layout_height="wrap_content"
	android:padding="@dimen/dip_5"
	android:background="@drawable/table_normal">
	<ImageView
		android:id="@+id/imgItem"
		android:layout_width="@dimen/dip_70"
		android:layout_height="@dimen/dip_70"
		android:scaleType="centerInside"
		android:adjustViewBounds="true"
		android:src="@drawable/no_image"
		android:layout_gravity="center_vertical"
		/>
	<LinearLayout
		android:layout_marginLeft="@dimen/dip_10"
		android:layout_width="0dip"
		android:layout_weight="1"
		android:orientation="vertical"
		android:layout_height="wrap_content">

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="horizontal">

			<LinearLayout
				android:layout_width="0dip"
				android:layout_weight="1"
				android:orientation="vertical"
				android:layout_height="wrap_content">

				<TextView
					android:layout_marginTop="@dimen/dip_5"
					android:id="@+id/txtEquipmentKey"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:text="Equipment Key"
					style="@style/Font15NormalBlack" />
				<TextView
					android:layout_marginTop="@dimen/dip_5"
					android:id="@+id/txtMakeDesc"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:text="Make Description"
					style="@style/Font15NormalBlack" />
			</LinearLayout>

			<ImageView
				android:id="@+id/imgCheck"
				android:layout_width="@dimen/dip_30"
				android:layout_height="@dimen/dip_30"
				android:layout_marginLeft="@dimen/dip_10"
				android:layout_marginRight="@dimen/dip_10"
				android:layout_gravity="center_vertical"
				android:src="@drawable/icon_check" />

		</LinearLayout>

		<TextView
			android:layout_marginTop="@dimen/dip_5"
			android:id="@+id/txtEquipDesc"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:text="Equipment Description"
			style="@style/Font15NormalBlack" />
		<LinearLayout
			android:gravity="center"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="horizontal">
			<TextView
				android:id="@+id/txtInstalledDate"
				android:layout_width="0dip"
				android:layout_weight="1"
				android:layout_height="wrap_content"
				android:text="Installed date"
				style="@style/Font15NormalBlack" />
			<dsd.dsdvansales.views.ClickEffectImageView
				android:id="@+id/imgCamera"
				android:layout_width="@dimen/dip_30"
				android:layout_height="@dimen/dip_30"
				android:layout_marginLeft="@dimen/dip_10"
				android:layout_marginRight="@dimen/dip_10"
				android:layout_gravity="center_vertical"
				android:src="@drawable/icon_no_photo" />
			<dsd.dsdvansales.views.ClickEffectImageView
				android:id="@+id/imgRepair"
				android:layout_width="@dimen/dip_30"
				android:layout_height="@dimen/dip_30"
				android:layout_marginLeft="@dimen/dip_10"
				android:layout_marginRight="@dimen/dip_10"
				android:layout_gravity="center_vertical"
				android:src="@drawable/ic_repair" />
		</LinearLayout>
	</LinearLayout>


</LinearLayout>
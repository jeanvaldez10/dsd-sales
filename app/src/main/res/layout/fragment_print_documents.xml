<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical">
	<RelativeLayout
		android:background="@color/button_grey_color"
		android:layout_width="fill_parent"
		android:layout_height="wrap_content"
		android:padding="@dimen/dip_10"
		>
		<TextView
			android:layout_alignParentRight="true"
			android:id="@+id/txtTrip"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginLeft="@dimen/dip_10"
			android:text="Trip # 102040507"
			style="@style/Font15NormalWhite" />
	</RelativeLayout>
	<RelativeLayout
		android:layout_marginTop="@dimen/dip_10"
		android:layout_width="match_parent"
		android:layout_height="wrap_content">
		<dsd.dsdvansales.views.ClickEffectImageView
			android:id="@+id/btnFilter"
			android:padding="@dimen/dip_5"
			android:src="@drawable/icon_filter"
			android:layout_marginLeft="@dimen/dip_10"
			android:layout_width="@dimen/dip_30"
			android:layout_height="@dimen/dip_30"
			android:layout_centerVertical="true">

		</dsd.dsdvansales.views.ClickEffectImageView>
		<TextView
			android:id="@+id/lblTitle"
			android:layout_width="fill_parent"
			android:layout_height="wrap_content"
			android:gravity="center_horizontal"
			android:text="PRINT DOCUMENTS"
			style="@style/Font25BoldGray" />
	</RelativeLayout>

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:orientation="vertical"
		android:padding="@dimen/dip_10">
		<ImageView
			android:layout_width="fill_parent"
			android:layout_height="@dimen/dip_1"
			android:background="@color/split_color" />
		<LinearLayout
			android:layout_width="fill_parent"
			android:layout_height="0dip"
			android:layout_weight="1"
			android:layout_marginTop="@dimen/dip_10"
			android:orientation="vertical">
			<ListView
				android:id="@+id/listView"
				android:layout_width="fill_parent"
				android:layout_height="fill_parent"
				android:dividerHeight="@dimen/dip_1"
				android:divider="@color/split_color" />
			<TextView
				android:id="@+id/txtNoData"
				android:layout_width="fill_parent"
				android:layout_height="fill_parent"
				android:text="@string/msg_no_data"
				android:gravity="center"
				android:visibility="gone"
				style="@style/Font20NormalGray" />
		</LinearLayout>
		<RelativeLayout
			android:layout_width="fill_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="@dimen/dip_10"
			android:orientation="horizontal">
			<Button
				android:id="@+id/btnCompleted"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:paddingTop="@dimen/dip_10"
				android:paddingBottom="@dimen/dip_10"
				android:paddingLeft="@dimen/dip_20"
				android:paddingRight="@dimen/dip_20"
				android:layout_alignParentRight="true"
				android:background="@drawable/btn_orange_large"
				android:text="Completed"
				style="@style/Font20NormalWhite" />
		</RelativeLayout>
	</LinearLayout>

</LinearLayout>
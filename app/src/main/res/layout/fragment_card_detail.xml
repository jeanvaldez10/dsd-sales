<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical">
	<RelativeLayout
		android:padding="@dimen/dip_10"
		android:background="@color/button_grey_color"
		android:layout_width="match_parent"
		android:layout_height="wrap_content">
		<TextView
			android:id="@+id/txtCustomerName"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="Customer Name"
			style="@style/Font15NormalWhite" />
	</RelativeLayout>
	<TextView
		android:id="@+id/lblTitle"
		android:layout_width="fill_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="@dimen/dip_10"
		android:gravity="center_horizontal"
		android:text="CARD PAYMENT DETAILS"
		style="@style/Font25BoldGray" />
	<LinearLayout
		android:padding="@dimen/dip_10"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:orientation="vertical">
		<ImageView
			android:layout_width="fill_parent"
			android:layout_height="@dimen/dip_1"
			android:background="@color/split_color" />
		<LinearLayout
			android:layout_width="fill_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="@dimen/dip_10">
			<TextView
				android:id="@+id/lblCollectionRequired"
				android:layout_width="0dip"
				android:layout_weight="2"
				android:layout_height="wrap_content"
				android:layout_gravity="center_vertical"
				android:text="Collection required"
				style="@style/Font15NormalBlack" />
			<TextView
				android:id="@+id/txtCollectionRequired"
				android:layout_width="0dip"
				android:layout_weight="1"
				android:layout_height="wrap_content"
				android:layout_gravity="center_vertical"
				android:text="$0.00"
				android:gravity="right"
				style="@style/Font15NormalBlack" />
		</LinearLayout>
		<LinearLayout
			android:layout_width="fill_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="@dimen/dip_10">
			<TextView
				android:id="@+id/lblTotalCollected"
				android:layout_width="0dip"
				android:layout_weight="2"
				android:layout_height="wrap_content"
				android:layout_gravity="center_vertical"
				android:text="Total collected"
				style="@style/Font15NormalBlack" />
			<TextView
				android:id="@+id/txtTotalCollected"
				android:layout_width="0dip"
				android:layout_weight="2"
				android:layout_height="wrap_content"
				android:layout_gravity="center_vertical"
				android:text="0.00"
				android:gravity="right"
				style="@style/Font15NormalBlack" />
		</LinearLayout>
		<LinearLayout
			android:layout_width="fill_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="@dimen/dip_10">
			<TextView
				android:id="@+id/lblTotalRemaining"
				android:layout_width="0dip"
				android:layout_weight="2"
				android:layout_height="wrap_content"
				android:layout_gravity="center_vertical"
				android:text="Total remaining"
				style="@style/Font15NormalBlack" />
			<TextView
				android:id="@+id/txtTotalRemaining"
				android:layout_width="0dip"
				android:layout_weight="2"
				android:layout_height="wrap_content"
				android:layout_gravity="center_vertical"
				android:text="0.00"
				android:gravity="right"
				style="@style/Font15NormalBlack" />
		</LinearLayout>
		<ImageView
			android:layout_width="fill_parent"
			android:layout_height="@dimen/dip_1"
			android:layout_marginTop="@dimen/dip_10"
			android:background="@color/split_color" />
		<LinearLayout
			android:layout_width="fill_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="@dimen/dip_10">
			<TextView
				android:id="@+id/lblReferenceNumber"
				android:layout_width="0dip"
				android:layout_weight="1"
				android:layout_height="wrap_content"
				android:layout_gravity="center_vertical"
				android:text="Reference Number"
				style="@style/Font15NormalBlack" />
			<EditText
				android:id="@+id/editReferenceNumber"
				android:layout_width="0dip"
				android:layout_weight="1"
				android:layout_height="wrap_content"
				android:layout_gravity="center_vertical"
				android:inputType="number"
				android:imeOptions="actionNext"
				style="@style/Font15NormalBlack" />
		</LinearLayout>
		<LinearLayout
			android:layout_width="fill_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="@dimen/dip_10">
			<LinearLayout
				android:layout_width="0dip"
				android:layout_weight="1"
				android:layout_height="wrap_content"
				android:layout_gravity="center_vertical">
				<TextView
					android:id="@+id/lblAmount"
					android:layout_width="0dip"
					android:layout_weight="1"
					android:layout_height="wrap_content"
					android:layout_gravity="center_vertical"
					android:text="Amount"
					style="@style/Font15NormalBlack" />
				<TextView
					android:id="@+id/lblCurrencySymbol"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_gravity="center_vertical"
					android:text="$"
					style="@style/Font15NormalBlack" />
			</LinearLayout>
			<EditText
				android:id="@+id/editAmount"
				android:layout_width="0dip"
				android:layout_weight="1"
				android:layout_height="wrap_content"
				android:layout_gravity="center_vertical"
				android:inputType="number"
				android:imeOptions="actionNext"
				style="@style/Font15NormalBlack" />
		</LinearLayout>
		<LinearLayout
			android:layout_width="fill_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="@dimen/dip_10">
			<TextView
				android:id="@+id/lblARNotes"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_gravity="center_vertical"
				android:text="AR Notes"
				style="@style/Font15NormalBlack" />
			<EditText
				android:id="@+id/editARNotes"
				android:layout_width="0dip"
				android:layout_weight="1"
				android:layout_height="wrap_content"
				android:layout_gravity="center_vertical"
				android:layout_marginLeft="@dimen/dip_10"
				android:maxLength="20"
				android:inputType="textCapSentences"
				android:imeOptions="actionDone"
				style="@style/Font15NormalBlack" />
		</LinearLayout>
		<ImageView
			android:layout_width="fill_parent"
			android:layout_height="0dip"
			android:layout_weight="1" />
		<RelativeLayout
			android:layout_width="fill_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="@dimen/dip_10"
			android:orientation="horizontal">
			<Button
				android:id="@+id/btnBack"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:padding="@dimen/dip_10"
				android:layout_gravity="center_vertical"
				android:drawableLeft="@drawable/icon_left_arrow"
				android:background="@drawable/btn_button_grey_large" />
			<Button
				android:id="@+id/btnCompleted"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:paddingTop="@dimen/dip_10"
				android:paddingBottom="@dimen/dip_10"
				android:paddingLeft="@dimen/dip_20"
				android:paddingRight="@dimen/dip_20"
				android:layout_centerVertical="true"
				android:layout_alignParentRight="true"
				android:background="@drawable/btn_orange_large"
				android:text="Completed"
				style="@style/Font20NormalWhite" />
		</RelativeLayout>
	</LinearLayout>

</LinearLayout>
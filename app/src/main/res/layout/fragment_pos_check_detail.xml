<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical">
	<RelativeLayout
		android:padding="@dimen/dip_10"
		android:background="@color/button_grey_color"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		>
		<TextView
			android:id="@+id/txtCustomerName"
			android:layout_width="fill_parent"
			android:layout_height="wrap_content"
			android:text="Customer Name"
			style="@style/Font15NormalWhite" />
	</RelativeLayout>
	<TextView
		android:id="@+id/lblTitle"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_marginTop="@dimen/dip_10"
		android:layout_gravity="center_horizontal"
		android:text="PRE TRIP CHECK"
		style="@style/Font25BoldGray" />
	<TextView
		android:id="@+id/txtVisitStarted"
		android:visibility="gone"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_marginTop="@dimen/dip_5"
		android:text="Visit Started at 15:18:30"
		style="@style/Font15NormalBlack" />
	<TextView
		android:visibility="gone"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_marginTop="@dimen/dip_5"
		android:layout_marginLeft="@dimen/dip_10"
		android:text="Visit Started at 15:18:30"
		style="@style/Font15NormalBlack" />
	<ImageView
		android:layout_width="fill_parent"
		android:layout_height="@dimen/dip_1"
		android:layout_marginTop="@dimen/dip_10"
		android:layout_marginLeft="@dimen/dip_10"
		android:layout_marginRight="@dimen/dip_10"
		android:background="@color/split_color" />
	<LinearLayout
		android:layout_width="fill_parent"
		android:layout_height="0dip"
		android:layout_weight="1"
		android:layout_margin="@dimen/dip_10"
		android:orientation="vertical">
		<ListView
			android:id="@+id/listView"
			android:layout_width="fill_parent"
			android:layout_height="fill_parent"
			android:dividerHeight="0dip"
			android:divider="@null"
			 />
		<TextView
			android:id="@+id/txtNoData"
			android:layout_width="fill_parent"
			android:layout_height="fill_parent"
			android:text="@string/msg_no_data"
			android:gravity="center"
			android:visibility="gone"
			style="@style/Font20NormalGray" />
	</LinearLayout>
	<LinearLayout
		android:layout_width="fill_parent"
		android:layout_height="wrap_content"
		android:layout_margin="@dimen/dip_10">
		<Button
			android:id="@+id/btnBack"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:padding="@dimen/dip_10"
			android:layout_gravity="center_vertical"
			android:drawableLeft="@drawable/icon_left_arrow"
			android:background="@drawable/btn_button_grey_large" />
		<ImageView
			android:layout_width="0dip"
			android:layout_weight="1"
			android:layout_height="wrap_content" />
		<Button
			android:visibility="gone"
			android:id="@+id/btnPhoto"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_gravity="center_vertical"
			android:drawableLeft="@drawable/icon_photo"
			android:background="@drawable/btn_white_small" />
		<ImageView
			android:layout_width="0dip"
			android:layout_weight="2"
			android:layout_height="wrap_content" />
		<Button
			android:id="@+id/btnCompleted"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_gravity="center_vertical"
			android:background="@drawable/btn_orange_large"
			android:text="Completed"
			android:padding="@dimen/dip_10"
			style="@style/Font20NormalWhite" />
	</LinearLayout>
</LinearLayout>
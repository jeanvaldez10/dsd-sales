<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical">
	<TextView
		android:id="@+id/lblTitle"
		android:layout_width="fill_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="@dimen/dip_20"
		android:gravity="center_horizontal"
		android:text="CONSIGNMENT INVENTORY"
		style="@style/Font25BoldGray" />
	<ImageView
		android:layout_width="fill_parent"
		android:layout_height="@dimen/dip_1"
		android:layout_marginTop="@dimen/dip_10"
		android:layout_marginLeft="@dimen/dip_10"
		android:layout_marginRight="@dimen/dip_10"
		android:background="@color/split_color" />
	<LinearLayout
		android:layout_width="fill_parent"
		android:layout_height="wrap_content"
		android:layout_margin="@dimen/dip_10">
		<TextView
			android:id="@+id/lblYouHaveLoaded"
			android:layout_width="0dip"
			android:layout_weight="2"
			android:layout_height="wrap_content"
			android:layout_marginLeft="@dimen/dip_10"
			android:text="You have loaded a total of"
			style="@style/Font15NormalBlack" />
	</LinearLayout>

	<ImageView
		android:layout_width="fill_parent"
		android:layout_height="@dimen/dip_1"
		android:layout_marginLeft="@dimen/dip_10"
		android:layout_marginRight="@dimen/dip_10"
		android:background="@color/split_color" />
	<LinearLayout
		android:padding="@dimen/dip_10"
		android:layout_width="fill_parent"
		android:layout_height="wrap_content"
		>
		<TextView
			android:id="@+id/lblReceiverName"
			android:layout_width="0dip"
			android:layout_weight="1"
			android:layout_height="wrap_content"
			android:text="Receipt Number"
			style="@style/Font15NormalBlack" />
		<EditText
			android:maxLength="12"
			android:id="@+id/editReceiverName"
			android:layout_width="0dip"
			android:layout_weight="1"
			android:layout_height="wrap_content"
			android:singleLine="true"
			android:inputType="text"
			android:imeOptions="actionNext"
			style="@style/Font15NormalBlack" />
	</LinearLayout>
	<Button
		android:id="@+id/btnSignature"
		android:layout_width="fill_parent"
		android:layout_height="wrap_content"
		android:layout_margin="@dimen/dip_10"
		android:padding="@dimen/dip_5"
		android:background="@drawable/btn_white_large"
		android:text="Signature"
		style="@style/Font20NormalBlack" />
	<ImageView
		android:layout_width="fill_parent"
		android:layout_height="0dip"
		android:layout_weight="1" />
	<RelativeLayout
		android:layout_width="fill_parent"
		android:layout_height="wrap_content"
		android:layout_margin="@dimen/dip_10">
		<Button
			android:id="@+id/btnBack"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:padding="@dimen/dip_10"
			android:layout_centerVertical="true"
			android:layout_gravity="center_vertical"
			android:drawableLeft="@drawable/icon_left_arrow"
			android:background="@drawable/btn_button_grey_large"
			android:layout_alignParentLeft="true"/>
		<Button
			android:layout_centerVertical="true"
			android:id="@+id/btnCompleted"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_gravity="right"
			android:background="@drawable/btn_orange_large"
			android:text="Completed"
			android:layout_alignParentRight="true"
			style="@style/Font20NormalWhite" />
	</RelativeLayout>

</LinearLayout>
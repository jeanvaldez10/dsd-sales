<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="@dimen/dip_10"
    android:background="@drawable/table_normal"
    android:clickable="true"
    android:importantForAccessibility="no"
    android:orientation="vertical"
    android:paddingTop="@dimen/dip_5"
    android:paddingBottom="@dimen/dip_5">

    <TextView
        android:id="@+id/customer_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="@color/black_color"
        android:textSize="@dimen/dip_16" />

    <TextView
        android:id="@+id/customer_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dip_20"
        android:text=""
        android:textColor="@color/black_color"
        android:textSize="@dimen/dip_15"
        tools:visibility="visible" />
</LinearLayout>
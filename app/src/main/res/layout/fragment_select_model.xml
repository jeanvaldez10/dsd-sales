<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">
    <RelativeLayout
        android:padding="@dimen/dip_10"
        android:background="@color/button_grey_color"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:id="@+id/lblCustomerName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Customer Name"
            style="@style/Font15NormalWhite" />
    </RelativeLayout>
    <TextView
        android:id="@+id/lblTitle"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dip_10"
        android:gravity="center_horizontal"
        android:text="EQUIPMENT REPAIR"
        android:textAllCaps="true"
        style="@style/Font25BoldGray" />
    <ImageView
        android:layout_width="fill_parent"
        android:layout_height="@dimen/dip_1"
        android:layout_marginTop="@dimen/dip_10"
        android:layout_marginLeft="@dimen/dip_10"
        android:layout_marginRight="@dimen/dip_10"
        android:background="@color/split_color" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/dip_10">
        <TextView
            android:id="@+id/lblNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dip_10"
            android:text="Select preferred model"
            style="@style/Font15BoldBlack"/>
        <ListView
            android:layout_width="match_parent"
            android:layout_height="0dip"
            android:dividerHeight="0dip"
            android:divider="@null"
            android:id="@+id/modelList"
            android:layout_marginTop="@dimen/dip_10"
            android:layout_weight="1">

        </ListView>
        <LinearLayout
            android:layout_marginTop="@dimen/dip_10"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <Button
                android:id="@+id/btnReturn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:background="@drawable/btn_button_grey_large"
                android:text="Return"
                style="@style/Font20NormalWhite" />
            <ImageView
                android:layout_width="0dip"
                android:layout_weight="1"
                android:layout_height="wrap_content" />
            <Button
                android:id="@+id/btnConfirm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:background="@drawable/btn_orange_large"
                android:text="Confirm"
                style="@style/Font20NormalWhite" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>

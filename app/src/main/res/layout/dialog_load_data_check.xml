<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="fill_parent"
	android:layout_height="wrap_content"
	android:layout_margin="@dimen/dip_20"
	android:padding="@dimen/dip_20"
	android:layout_gravity="center"
	android:background="@color/white_color"
	android:orientation="vertical">
	<TextView
		android:id="@+id/txtTitle"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_gravity="center_horizontal"
		android:text="LOAD DATE CHECK ?"
		android:gravity="center_horizontal"
		style="@style/Font25BoldBlack" />
	<TextView
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:text="Please select the loads being loaded?"
		android:layout_gravity="center"
		android:layout_marginTop="@dimen/dip_10"
		style="@style/Font15BoldBlack"
		android:id="@+id/txtCaption"/>
	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="horizontal"
		android:layout_marginTop="@dimen/dip_10">
		<CheckBox
			android:visibility="invisible"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"></CheckBox>
		<TextView
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="4"
			android:text="Detail"
			android:maxLength="20"
			style="@style/Font18BoldBlack"
			android:gravity="left"
			android:id="@+id/txtDetail"
			/>
		<TextView
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="2"
			android:text="Load"
			style="@style/Font18BoldBlack"
			android:gravity="left"
			android:id="@+id/txtLoad"
			/>
		<TextView
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="2"
			android:text="Day"
			android:gravity="left"
			style="@style/Font18BoldBlack"
			android:id="@+id/txtDelivery"
			/>

	</LinearLayout>
	<ListView
		android:layout_width="match_parent"
		android:layout_height="@dimen/dip_150"
		android:layout_marginTop="@dimen/dip_5"
		android:id="@+id/list">

	</ListView>
	<RelativeLayout
		android:layout_width="fill_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="@dimen/dip_20"
		android:orientation="horizontal">
		<Button
			android:id="@+id/btnReturn"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_alignParentLeft="true"
			android:background="@drawable/btn_button_grey_large"
			android:text="Return"
			style="@style/Font20NormalWhite" />
		<Button
			android:id="@+id/btnSelect"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_alignParentRight="true"
			android:background="@drawable/btn_orange_large"
			android:text="Select"
			style="@style/Font20NormalWhite" />
	</RelativeLayout>
</LinearLayout>
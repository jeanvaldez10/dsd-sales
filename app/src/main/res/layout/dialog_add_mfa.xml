<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="fill_parent"
	android:layout_height="wrap_content"
	android:layout_margin="@dimen/dip_20"
	android:padding="@dimen/dip_15"
	android:layout_gravity="center"
	android:background="@color/white_color"
	android:orientation="vertical">
	<TextView
		android:id="@+id/txtTitle"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_marginTop="@dimen/dip_10"
		android:layout_gravity="center_horizontal"
		android:text="Add Multi Factor Authentication"
		android:gravity="center_horizontal"
		style="@style/Font25BoldBlack" />

	<TextView
		android:id="@+id/txtMessage"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_marginTop="@dimen/dip_20"
		android:layout_marginBottom="@dimen/dip_10"
		android:layout_marginLeft="@dimen/dip_10"
		android:layout_marginRight="@dimen/dip_10"
		android:layout_gravity="center"
		android:text="Scan the QR Code by Microsoft Authenticator App to Add MFA"
		style="@style/Font20NormalBlack" />

	<ImageView
		android:id="@+id/qr_image_view"
		android:layout_width="200dp"
		android:layout_margin="@dimen/dip_10"
		android:layout_height="200dp"
		android:layout_gravity="center"
		android:scaleType="fitXY"/>

	<RelativeLayout
		android:layout_width="fill_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="@dimen/dip_20"
		android:layout_marginBottom="@dimen/dip_20"
		android:layout_marginLeft="@dimen/dip_10"
		android:layout_marginRight="@dimen/dip_10"
		android:orientation="horizontal">
		<Button
			android:id="@+id/btnReturn"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:paddingTop="@dimen/dip_10"
			android:paddingBottom="@dimen/dip_10"
			android:paddingLeft="@dimen/dip_20"
			android:paddingRight="@dimen/dip_20"
			android:layout_centerHorizontal="true"
			android:background="@drawable/btn_button_grey_large"
			android:text="Return"
			style="@style/Font20NormalWhite" />
	</RelativeLayout>
</LinearLayout>
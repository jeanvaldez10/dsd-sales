<RelativeLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="@drawable/img_login_bg"
	android:id="@+id/background"
	>
	<ImageView
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:adjustViewBounds="true"
		android:id="@+id/logo"
		android:scaleType="centerCrop"
		/>
	<ImageView
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:background="@drawable/login_bg"/>
	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:orientation="vertical">
		<ImageView
			android:layout_width="wrap_content"
			android:layout_height="0dip"
			android:layout_weight="1" />
		<TextView
			android:id="@+id/lblLogin"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_gravity="center_horizontal"
			android:text="LOG IN"
			style="@style/Font25BoldGray" />
		<EditText
			android:id="@+id/editUsername"
			android:layout_width="fill_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="@dimen/dip_10"
			android:layout_marginLeft="@dimen/dip_10"
			android:layout_marginRight="@dimen/dip_10"
			android:inputType="text"
			android:imeOptions="actionNext"
			android:hint="Username"
			android:gravity="center"
			style="@style/Font20NormalBlack" />
		<RelativeLayout
			android:layout_width="match_parent"
			android:id="@+id/layout_spinner"
			android:layout_height="wrap_content">
			<ImageView
				android:layout_width="@dimen/dip_30"
				android:layout_height="@dimen/dip_30"
				android:padding="@dimen/dip_5"
				android:layout_alignParentRight="true"
				android:layout_centerVertical="true"
				android:layout_marginTop="@dimen/dip_10"
				android:layout_marginRight="@dimen/dip_15"
				android:src="@drawable/dropdown"/>
			<Spinner
				android:id="@+id/spinUserName"
				android:layout_width="fill_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="@dimen/dip_10"
				android:layout_marginLeft="@dimen/dip_10"
				android:layout_marginRight="@dimen/dip_10"
				android:inputType="text"
				android:layout_centerVertical="true"
				android:padding = "@dimen/dip_7"
				android:background="@drawable/bg_spinner"
				android:gravity="center"
				android:textColor="@color/black_color"
				android:textSize="@dimen/dip_20" />
		</RelativeLayout>
		<EditText
			android:id="@+id/editPinNumber"
			android:layout_width="fill_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="@dimen/dip_10"
			android:layout_marginLeft="@dimen/dip_10"
			android:layout_marginRight="@dimen/dip_10"
			android:inputType="numberPassword"
			android:hint="PIN Number"
			android:imeOptions="actionNext"
			android:gravity="center"
			style="@style/Font20NormalBlack" />
		<EditText
			android:id="@+id/editTripNumber"
			android:layout_width="fill_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="@dimen/dip_10"
			android:layout_marginLeft="@dimen/dip_10"
			android:layout_marginRight="@dimen/dip_10"
			android:inputType="number"
			android:imeOptions="actionDone"
			android:hint="Trip Number"
			android:gravity="center"
			style="@style/Font20NormalBlack" />
		<RelativeLayout
			android:layout_width="fill_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="@dimen/dip_10"
			android:layout_marginBottom="@dimen/dip_10"
			android:layout_marginLeft="@dimen/dip_10"
			android:layout_marginRight="@dimen/dip_10"
			android:orientation="horizontal">

			<Button
				android:id="@+id/btnExit"
				style="@style/Font20NormalWhite"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_alignParentLeft="true"
				android:background="@drawable/btn_button_grey_large"
				android:text="Exit" />
			<Button
				android:id="@+id/btnLogin"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_alignParentRight="true"
				android:background="@drawable/btn_orange_large"
				android:text="Log In"
				style="@style/Font20NormalWhite" />
		</RelativeLayout>
	</LinearLayout>
</RelativeLayout>

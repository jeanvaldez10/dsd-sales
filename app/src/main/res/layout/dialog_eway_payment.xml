<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="fill_parent"
	android:layout_height="wrap_content"
	android:layout_margin="@dimen/dip_20"
	android:layout_gravity="center"
	android:padding="@dimen/dip_10"
	android:background="@color/white_color"
	android:orientation="vertical">
	<TextView
		android:id="@+id/txtTitle"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_margin="@dimen/dip_10"
		android:layout_gravity="center_horizontal"
		android:text="CARD PAYMENT"
		style="@style/Font20NormalBlack" />
	<ImageView
		android:layout_width="@dimen/dip_100"
		android:layout_height="@dimen/dip_100"
		android:layout_gravity="center"
		android:id="@+id/imgLogo"/>
	<TextView
		android:layout_gravity="center"
		android:id="@+id/txtClientName"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:text="Client Name"
		style="@style/Font15BoldBlack" />
	<TextView
		android:layout_marginTop="@dimen/dip_10"
		android:id="@+id/lblCardName"
		android:layout_width="fill_parent"
		android:layout_height="wrap_content"
		android:layout_marginLeft="@dimen/dip_10"
		android:text="Name on Card"
		style="@style/Font15NormalBlack" />
	<EditText
		android:id="@+id/editCardName"
		android:layout_width="fill_parent"
		android:layout_height="wrap_content"
		android:singleLine="true"
		android:inputType="textCapWords"
		android:imeOptions="actionNext"
		style="@style/Font15NormalBlack" />
	<TextView
		android:id="@+id/lblCardNo"
		android:layout_width="fill_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="@dimen/dip_5"
		android:layout_marginLeft="@dimen/dip_10"
		android:text="Card Number"
		style="@style/Font15NormalBlack" />
	<LinearLayout
		android:layout_width="fill_parent"
		android:layout_height="wrap_content">
		<EditText
			android:id="@+id/editCardNo1"
			android:layout_width="0dip"
			android:layout_weight="1"
			android:layout_height="wrap_content"
			android:singleLine="true"
			android:maxLength="4"
			android:inputType="number"
			android:imeOptions="actionNext"
			style="@style/Font15NormalBlack" />
		<EditText
			android:id="@+id/editCardNo2"
			android:layout_width="0dip"
			android:layout_weight="1"
			android:layout_height="wrap_content"
			android:layout_marginLeft="@dimen/dip_5"
			android:singleLine="true"
			android:maxLength="4"
			android:inputType="number"
			android:imeOptions="actionNext"
			style="@style/Font15NormalBlack" />
		<EditText
			android:id="@+id/editCardNo3"
			android:layout_width="0dip"
			android:layout_weight="1"
			android:layout_height="wrap_content"
			android:layout_marginLeft="@dimen/dip_5"
			android:singleLine="true"
			android:maxLength="4"
			android:inputType="number"
			android:imeOptions="actionNext"
			style="@style/Font15NormalBlack" />
		<EditText
			android:id="@+id/editCardNo4"
			android:layout_width="0dip"
			android:layout_weight="1"
			android:layout_height="wrap_content"
			android:layout_marginLeft="@dimen/dip_5"
			android:singleLine="true"
			android:maxLength="4"
			android:inputType="number"
			android:imeOptions="actionNext"
			style="@style/Font15NormalBlack" />
	</LinearLayout>
	<LinearLayout
		android:layout_width="fill_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="@dimen/dip_5">
		<LinearLayout
			android:layout_width="0dip"
			android:layout_weight="2"
			android:layout_height="wrap_content"
			android:orientation="vertical">
			<TextView
				android:layout_width="fill_parent"
				android:layout_height="wrap_content"
				android:layout_marginLeft="@dimen/dip_10"
				android:text="CVV"
				style="@style/Font15NormalBlack" />
			<EditText
				android:id="@+id/editCVN"
				android:layout_width="fill_parent"
				android:layout_height="wrap_content"
				android:singleLine="true"
				android:maxLength="4"
				android:inputType="number"
				android:imeOptions="actionNext"
				style="@style/Font15NormalBlack" />
		</LinearLayout>
		<ImageView
			android:layout_width="0dip"
			android:layout_weight="1"
			android:layout_height="wrap_content" />
		<LinearLayout
			android:layout_width="0dip"
			android:layout_weight="3"
			android:layout_height="wrap_content"
			android:orientation="vertical">
			<TextView
				android:id="@+id/lblExpire"
				android:layout_width="fill_parent"
				android:layout_height="wrap_content"
				android:layout_gravity="center_vertical"
				android:text="Expiry Date"
				style="@style/Font15NormalBlack" />
			<LinearLayout
				android:layout_width="fill_parent"
				android:layout_height="wrap_content">
				<EditText
					android:id="@+id/editExpiryMonth"
					android:layout_width="0dip"
					android:layout_weight="1"
					android:layout_height="wrap_content"
					android:layout_gravity="center_vertical"
					android:singleLine="true"
					android:maxLength="2"
					android:inputType="number"
					android:imeOptions="actionNext"
					style="@style/Font15NormalBlack" />
				<TextView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_gravity="center_vertical"
					android:text=" / "
					style="@style/Font15NormalBlack" />
				<EditText
					android:id="@+id/editExpiryYear"
					android:layout_width="0dip"
					android:layout_weight="1"
					android:layout_height="wrap_content"
					android:layout_gravity="center_vertical"
					android:singleLine="true"
					android:maxLength="2"
					android:inputType="number"
					android:imeOptions="actionNext"
					style="@style/Font15NormalBlack" />
			</LinearLayout>
		</LinearLayout>
		<ImageView
			android:layout_width="0dip"
			android:layout_weight="1"
			android:layout_height="wrap_content" />
	</LinearLayout>
	<LinearLayout
		android:layout_width="fill_parent"
		android:layout_height="wrap_content"
		android:orientation="horizontal"
		android:layout_marginTop="@dimen/dip_5">
		<LinearLayout
			android:layout_width="0dip"
			android:layout_weight="10"
			android:layout_height="wrap_content"
			android:orientation="vertical">
			<TextView
				android:id="@+id/lblAmount"
				android:layout_width="fill_parent"
				android:layout_height="wrap_content"
				android:layout_marginLeft="@dimen/dip_10"
				android:text="Amount"
				style="@style/Font15NormalBlack" />
			<EditText
				android:id="@+id/editAmount"
				android:layout_width="fill_parent"
				android:layout_height="wrap_content"
				android:singleLine="true"
				android:inputType="number"
				android:imeOptions="actionDone"
				style="@style/Font15NormalBlack" />
		</LinearLayout>
		<ImageView
			android:layout_width="0dip"
			android:layout_height="wrap_content"
			android:layout_weight="2"
			android:layout_gravity="center"
			android:layout_marginLeft="@dimen/dip_10"
			android:adjustViewBounds="true"
			android:src="@drawable/icon_eway_logo"
			 />
	</LinearLayout>
	<LinearLayout
		android:layout_width="fill_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="@dimen/dip_10"
		android:orientation="horizontal">
		<Button
			android:id="@+id/btnLeft"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:padding="@dimen/dip_10"
			android:background="@drawable/btn_button_grey_large"
			android:text="Return"
			style="@style/Font20NormalWhite" />
		<ImageView
			android:layout_width="0dip"
			android:layout_weight="1"
			android:layout_height="wrap_content" />
		<Button
			android:id="@+id/btnMiddle"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:padding="@dimen/dip_10"
			android:background="@drawable/btn_button_grey_large"
			android:text="Manual"
			style="@style/Font20NormalWhite" />
		<ImageView
			android:layout_width="0dip"
			android:layout_weight="1"
			android:layout_height="wrap_content" />
		<Button
			android:minWidth="@dimen/dip_80"
			android:id="@+id/btnRight"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:padding="@dimen/dip_10"
			android:background="@drawable/btn_orange_large"
			android:text="Pay"
			style="@style/Font20NormalWhite" />
	</LinearLayout>
</LinearLayout>
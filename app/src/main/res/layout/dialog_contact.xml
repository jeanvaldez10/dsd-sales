<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="fill_parent"
	android:layout_height="wrap_content"
	android:layout_margin="@dimen/dip_20"
	android:layout_gravity="center"
	android:background="@color/white_color"
	android:orientation="vertical">
	<TextView
		android:id="@+id/txtCustomerName"
		android:layout_width="fill_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="@dimen/dip_20"
		android:layout_marginLeft="@dimen/dip_20"
		android:layout_marginRight="@dimen/dip_20"
		android:gravity="center_horizontal"
		android:text="customer name"
		style="@style/Font20NormalBlack" />
	<ImageView
		android:layout_width="fill_parent"
		android:layout_height="@dimen/dip_2"
		android:layout_marginTop="@dimen/dip_5"
		android:layout_marginLeft="@dimen/dip_20"
		android:layout_marginRight="@dimen/dip_20"
		android:background="@color/split_color" />
	<Button
		android:id="@+id/btnTelephone"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_marginTop="@dimen/dip_10"
		android:layout_marginLeft="@dimen/dip_20"
		android:layout_marginRight="@dimen/dip_20"
		android:drawableLeft="@drawable/icon_call"
		android:drawablePadding="@dimen/dip_10"
		android:background="@drawable/btn_white_medium"
		android:text="Phone"
		style="@style/Font20NormalBlack" />
	<Button
		android:id="@+id/btnSMSMessage"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_marginTop="@dimen/dip_10"
		android:layout_marginLeft="@dimen/dip_20"
		android:layout_marginRight="@dimen/dip_20"
		android:drawableLeft="@drawable/icon_sms"
		android:drawablePadding="@dimen/dip_10"
		android:background="@drawable/btn_white_medium"
		android:text="SMS"
		style="@style/Font20NormalBlack" />
	<Button
		android:id="@+id/btnEmail"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_marginTop="@dimen/dip_10"
		android:layout_marginLeft="@dimen/dip_20"
		android:layout_marginRight="@dimen/dip_20"
		android:drawableLeft="@drawable/icon_message"
		android:drawablePadding="@dimen/dip_10"
		android:background="@drawable/btn_white_medium"
		android:text="Email"
		style="@style/Font20NormalBlack" />
	<RelativeLayout
		android:layout_width="fill_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="@dimen/dip_10"
		android:layout_marginBottom="@dimen/dip_20"
		android:layout_marginRight="@dimen/dip_20"
		android:orientation="horizontal">
		<Button
			android:id="@+id/btnReturn"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_alignParentRight="true"
			android:background="@drawable/btn_orange_large"
			android:text="Return"
			style="@style/Font20NormalWhite" />
	</RelativeLayout>
</LinearLayout>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/table_normal">
    <TextView
        android:background="@drawable/table_normal"
        style="@style/Font12NormalBlack"
        android:id="@+id/txtCustomerName"
        android:layout_gravity="center"
        android:layout_marginTop="5dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
    </TextView>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:background="@drawable/table_normal"
            android:id="@+id/layoutOrderNumber"
            android:layout_width="0dip"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:id="@+id/txtOrderNumber"
                    android:text="Order Number"
                    android:layout_width="wrap_content"
                    style="@style/Font12NormalBlack"
                    android:layout_height="wrap_content">
                </TextView>
                <TextView
                    style="@style/Font12NormalBlack"
                    android:layout_marginLeft="5dp"
                    android:id="@+id/txtPurchaseOrderNumber"
                    android:text="PO #: "
                    android:layout_width="0dip"
                    android:layout_weight="1"
                    android:layout_height="wrap_content">
                </TextView>
                <TextView
                    style="@style/Font12NormalBlack"
                    android:layout_marginLeft="5dp"
                    android:id="@+id/txtRequestDeliveryDate"
                    android:text="27/07/23"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                </TextView>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:id="@+id/txtDeliveryInstruction"
                    android:text="Delivery Instructions"
                    android:layout_width="0dip"
                    android:layout_weight="1"
                    style="@style/Font12NormalBlack"
                    android:layout_height="wrap_content">
                </TextView>
                <TextView
                    style="@style/Font12NormalBlack"
                    android:layout_marginLeft="5dp"
                    android:id="@+id/txtQuantityOrdered"
                    android:text="125"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                </TextView>
            </LinearLayout>
        </LinearLayout>
        <CheckBox
            android:layout_gravity="center"
            android:button="@null"
            android:drawableRight="?android:attr/listChoiceIndicatorMultiple"
            android:id="@+id/checkbox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/Font20NormalBlack"/>
    </LinearLayout>

</LinearLayout>
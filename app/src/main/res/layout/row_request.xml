<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:paddingTop="@dimen/dip_2"
	android:paddingBottom="@dimen/dip_2"
	android:background="@drawable/table_normal">
	<TextView
		android:id="@+id/txtShortDesc"
		android:layout_width="0dip"
		android:layout_weight="12"
		android:layout_height="wrap_content"
		android:layout_marginLeft="@dimen/dip_2"
		android:text="Short Desc"
		style="@style/Font12NormalBlack"/>
	<TextView
		android:id="@+id/txtPickLocationCode"
		android:layout_width="0dip"
		android:layout_weight="1"
		android:layout_height="wrap_content"
		android:layout_marginLeft="@dimen/dip_2"
		android:text="X"
		style="@style/Font12NormalBlack"/>
	<TextView
		android:id="@+id/txtSales"
		android:layout_width="@dimen/dip_30"
		android:layout_height="wrap_content"
		android:layout_marginLeft="@dimen/dip_2"
		android:text="1234"
		android:gravity="right"
		style="@style/Font12NormalBlack"/>
	<TextView
		android:id="@+id/txtOnTruck"
		android:layout_width="@dimen/dip_70"
		android:layout_height="wrap_content"
		android:layout_marginLeft="@dimen/dip_2"
		android:text=""
		android:gravity="right"
		style="@style/Font12NormalBlack"/>
	<TextView
		android:id="@+id/txtStock"
		android:layout_width="@dimen/dip_60"
		android:layout_height="wrap_content"
		android:layout_marginLeft="@dimen/dip_2"
		android:text=""
		android:gravity="right"
		style="@style/Font12NormalBlack"/>
</LinearLayout>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="fill_parent"
	android:layout_height="wrap_content"
	android:orientation="vertical">
	<TextView
		android:id="@+id/txtQuestion"
		android:layout_width="fill_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="@dimen/dip_10"
		android:text="question"
		style="@style/Font15NormalBlack" />
	<RadioGroup
		android:id="@+id/radioGroup"
		android:layout_width="fill_parent"
		android:layout_height="wrap_content"
		android:layout_margin="@dimen/dip_10"
		android:orientation="horizontal" >
		<RadioButton
			android:id="@+id/radioYes"
			android:layout_width="0dip"
			android:layout_weight="1"
			android:layout_height="wrap_content"
			android:text="Yes"
			style="@style/Font15NormalBlack" />
		<RadioButton
			android:id="@+id/radioNo"
			android:layout_width="0dip"
			android:layout_weight="1"
			android:layout_height="wrap_content"
			android:layout_marginLeft="@dimen/dip_5"
			android:text="No"
			style="@style/Font15NormalBlack" />
	</RadioGroup>
	<TextView
		android:id="@+id/txtChoice"
		android:layout_width="fill_parent"
		android:layout_height="wrap_content"
		android:layout_margin="@dimen/dip_10"
		android:drawableRight="@drawable/icon_drop_down"
		android:text="Please select the response."
		android:gravity="center_vertical"
		android:background="@drawable/btn_grey_large"
		style="@style/Font15NormalBlack" />
	<EditText
		android:id="@+id/editInput"
		android:layout_width="fill_parent"
		android:layout_height="wrap_content"
		android:layout_margin="@dimen/dip_10"
		android:hint="Please input the response."
		android:singleLine="true"
		android:inputType="textCapSentences"
		android:imeOptions="actionDone"
		style="@style/Font15NormalBlack" />
	<EditText
		android:id="@+id/editNumberInput"
		android:layout_width="fill_parent"
		android:layout_height="wrap_content"
		android:layout_margin="@dimen/dip_10"
		android:hint="Please input the response."
		android:singleLine="true"
		android:inputType="numberDecimal"
		android:imeOptions="actionDone"
		style="@style/Font15NormalBlack" />
	<Button
		android:layout_marginLeft="@dimen/dip_10"
		android:layout_marginRight="@dimen/dip_10"
		android:id="@+id/btnSignature"
		android:layout_width="fill_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="@dimen/dip_5"
		android:layout_marginBottom="@dimen/dip_10"
		android:padding="@dimen/dip_5"
		android:background="@drawable/btn_white_large"
		android:text="Signature"
		style="@style/Font20NormalBlack" />
	<RelativeLayout
		android:padding="@dimen/dip_10"
		android:id="@+id/layoutPrice"
		android:layout_width="match_parent"
		android:layout_height="wrap_content">
		<TextView
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="$"
			android:id="@+id/lblCurrencySymbol"
			android:gravity="right|center_vertical"
			style="@style/Font15BoldBlack"
			android:layout_centerVertical="true"
			android:layout_toLeftOf="@+id/editPrice"/>
		<EditText
			android:id="@+id/editPrice"
			android:layout_width="@dimen/dip_80"
			android:layout_height="wrap_content"
			android:hint=""
			android:singleLine="true"
			android:inputType="numberDecimal"
			android:imeOptions="actionNext"
			style="@style/Font15NormalBlack"
			android:layout_alignParentRight="true"
			/>
	</RelativeLayout>
	<LinearLayout
		android:gravity="center"
		android:layout_gravity="center"
		android:id="@+id/layoutBarcode"
		android:padding="@dimen/dip_10"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="horizontal">
		<TextView
			android:id="@+id/txtBarcode"
			android:layout_width="0dip"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:singleLine="true"></TextView>
		<dsd.dsdvansales.views.ClickEffectImageView
			android:id="@+id/btnBarcode"
			android:layout_marginLeft="@dimen/dip_10"
			android:src="@drawable/icon_barcode"
			android:layout_width="@dimen/dip_30"
			android:layout_height="@dimen/dip_30">

		</dsd.dsdvansales.views.ClickEffectImageView>
	</LinearLayout>
	<LinearLayout
		android:gravity="center"
		android:layout_gravity="center"
		android:id="@+id/layoutImage"
		android:padding="@dimen/dip_10"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="horizontal">
		<TextView
			android:id="@+id/txtImage"
			android:layout_width="0dip"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:singleLine="true"></TextView>
		<dsd.dsdvansales.views.ClickEffectImageView
			android:id="@+id/btnCamera"
			android:layout_marginLeft="@dimen/dip_10"
			android:src="@drawable/icon_photo"
			android:layout_width="@dimen/dip_30"
			android:layout_height="@dimen/dip_30">

		</dsd.dsdvansales.views.ClickEffectImageView>
	</LinearLayout>
	<LinearLayout
		android:gravity="center"
		android:layout_gravity="center"
		android:id="@+id/layoutDate"
		android:padding="@dimen/dip_10"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="horizontal">
		<EditText
			android:gravity="center"
			android:editable="false"
			android:id="@+id/editDate"
			android:layout_width="0dip"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:singleLine="true"></EditText>
		<dsd.dsdvansales.views.ClickEffectImageView
			android:id="@+id/btnDate"
			android:layout_marginLeft="@dimen/dip_10"
			android:src="@drawable/icon_pickdate"
			android:layout_width="@dimen/dip_30"
			android:layout_height="@dimen/dip_30">

		</dsd.dsdvansales.views.ClickEffectImageView>
	</LinearLayout>

	<View
		android:id="@+id/divider"
		android:layout_width="match_parent"
		android:layout_height="1dip"
		android:background="@color/divider_color"></View>
</LinearLayout>